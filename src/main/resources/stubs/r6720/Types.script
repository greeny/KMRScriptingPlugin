{
	KaM Remake scripting API stubs - Types (r6720).
	GENERATED by tools/generate_stubs.py from the wiki page Types-(Mission-Script-Dynamic); do not edit,
	put corrections into tools/overrides/r6720/Types.script instead.
}

type
	{
		Identifier of a unit (States.UnitAt, Actions.GiveUnitEx, event parameters). -1 = none.
		@hidden
		@kind id unit ID
	}
	TKMUnitID = Integer;

	{
		Identifier of a house (States.HouseAt, Actions.GiveHouseEx, event parameters). -1 = none.
		@hidden
		@kind id house ID
	}
	TKMHouseID = Integer;

	{
		Identifier of a group of warriors (States.GroupAt, Actions.GiveGroupEx). -1 = none.
		@hidden
		@kind id group ID
	}
	TKMGroupID = Integer;

	{
		Index of a hand (player), 0-based. -1 = none / all players, depending on the function.
		@hidden
		@kind index hand index
	}
	TKMHandIndex = Integer;

	{
		X (column) coordinate of a map tile.
		@hidden
		@kind coordinate X coordinate
	}
	TKMCoordX = Integer;

	{
		Y (row) coordinate of a map tile.
		@hidden
		@kind coordinate Y coordinate
	}
	TKMCoordY = Integer;

	{
		Integer unit type of the old API. Newer functions take TKMUnitType instead.
		@hidden
		@kind legacy-id unit type id
		@prefer TKMUnitType
	}
	TKMUnitTypeID = Integer;

	{
		Integer house type of the old API. Newer functions take TKMHouseType instead.
		@hidden
		@kind legacy-id house type id
		@prefer TKMHouseType
	}
	TKMHouseTypeID = Integer;

	{
		Integer ware type of the old API. Newer functions take TKMWareType instead.
		@hidden
		@kind legacy-id ware type id
		@prefer TKMWareType
	}
	TKMWareTypeID = Integer;

	{
		Integer group type of the old API (0 melee, 1 anti-horse, 2 ranged, 3 mounted). Newer functions take TKMGroupType instead.
		@hidden
		@kind legacy-id group type id
		@prefer TKMGroupType
	}
	TKMGroupTypeID = Integer;

	{
		Integer direction of the old API (0..7). Newer functions take TKMDirection instead.
		@hidden
		@kind legacy-id direction id
		@prefer TKMDirection
	}
	TKMDirectionID = Integer;

	{
		Number of game ticks (10 per second at normal speed): game time, delays, hunger levels.
		@hidden
		@kind count tick count
	}
	TKMTicks = Integer;

	{
		array of string values
	}
	TAnsiStringArray = array of AnsiString;

	{
		Array of bytes
	}
	TByteSet = set of Byte;

	{
		array of integer values
	}
	TIntegerArray = array of Integer;

	{
		AI attack setup
	}
	TKMAIAttackInfo = record
		UID: Integer;
		AttackType: TKMAIAttackType;
		HasOccured: Boolean;
		Delay: Cardinal;
		TotalMen: Integer;
		MeleeGroupCount: Integer;
		AntiHorseGroupCount: Integer;
		RangedGroupCount: Integer;
		MountedGroupCount: Integer;
		RandomGroups: Boolean;
		Target: TKMAIAttackTarget;
		CustomPosition: TKMPoint;
	end;

	{
		AI attack target
	}
	TKMAIAttackTarget = (
		attClosestUnit,  // Closest enemy unit untested as to whether this is relative to army or start position)
		attClosestBuildingFromArmy,  // Closest building from the group(s) lauching the attack
		attClosestBuildingFromStartPos,  // Closest building from the AI's start position
		attCustomPosition  // Custom point defined with CustomPosition
	);

	{
		AI attack type
	}
	TKMAIAttackType = (
		aatOnce,  // Attack will occur once (after the set time has passed and if they have enough troops
		aatRepeating  // Attack will happen multiple times, (after delay time) whenever the AI has enough troops
	);

	{
		AI defence position type
	}
	TKMAIDefencePosType = (
		dtFrontLine,  // Front line troops may not go on attacks, they are for defence
		dtBackLine  // Back line troops may attack
	);

	{
		House repair mode
	}
	TKMAIRepairMode = (
		rmNone,
		rmRepairNever,  // disable AI repair for all houses
		rmRepairAlways,  // enable AI repair for all houses
		rmRepairManual  // repair state is set by script manually via Actions.HouseRepairEnable
	);

	{
		AI army type
	}
	TKMArmyType = (
		atIronThenLeather,
		atLeather,
		atIron,
		atIronAndLeather
	);

	{
		Audio file format
	}
	TKMAudioFormat = (
		afWav,
		afOgg
	);

	{
		AI defence position setup
	}
	TKMDefencePositionInfo = record
		UID: Integer;
		{
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		X, Y: Integer;
		Radius: Integer;
		{
			@kind GroupID groupId
		}
		GroupID: Integer;
		Dir: TKMDirection;
		GroupType: TKMGroupType;
		PositionType: TKMAIDefencePosType;
	end;

	{
		Delivery mode
	}
	TKMDeliveryMode = (
		dmClosed,
		dmDelivery,
		dmTakeOut
	);

	{
		Facing direction
	}
	TKMDirection = (
		dirNA,
		dirN,
		dirNE,
		dirE,
		dirSE,
		dirS,
		dirSW,
		dirW,
		dirNW
	);

	{
		Field type
	}
	TKMFieldType = (
		ftNone,
		ftRoad,
		ftCorn,
		ftWine,
		ftInitWine  // Reset rotation and set grapes ground, but without Grapes yet
	);

	{
		Flip axis
	}
	TKMFlipAxis = (
		faHorizontal,
		faVertical
	);

	{
		Font type
	}
	TKMFont = (
		fntAntiqua,
		fntGame,
		fntGrey,
		fntMetal,
		fntMini,
		fntOutline,
		fntArial,  // Arial for MP chat
		fntMonospaced  // Debug overlay font (Consolas 8. Set WordSpacing to any Char.Width)
	);

	{
		Group order
	}
	TKMGroupOrder = (
		goNone,  // Last order was executed and now we have nothing to do
		goWalkTo,  // Ordered to walk somewhere or just change formation
		goAttackHouse,  // Attack house
		goAttackUnit,  // Attack specific unit
		goStorm  // Run forward
	);

	{
		Group type
	}
	TKMGroupType = (
		gtNone,
		gtAny,
		gtMelee,
		gtAntiHorse,
		gtRanged,
		gtMounted
	);

	{
		Group type set
	}
	TKMGroupTypeSet = set of TKMGroupType;

	{
		House lock state
	}
	TKMHandHouseLock = (
		hlNone,
		hlDefault,
		hlBlocked,  // Never allowed
		hlGranted  // Always allowed
	);

