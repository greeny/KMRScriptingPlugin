	TKMMissionDifficultySet = set of TKMMissionDifficulty;

	{
		Point with integer coordinates X and Y
	}
	TKMPoint = record
		{
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		X, Y: Integer;
	end;

	{
		Terrain kind
	}
	TKMTerrainKind = (
		tkCustom,  // 0
		tkGrass,  // 1
		tkMoss,  // 2
		tkPaleGrass,  // 3
		tkCoastSand,  // 4
