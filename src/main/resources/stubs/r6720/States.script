type
	{
		TKMScriptStates: type of the States object.
		@hidden
	}
	TKMScriptStates = record
		{
			Returns the group of the specified player and group type that is closest to the specified coordinates,
			or -1 if no such group was found.
			If the group type is -1 any group type will be accepted
			@since 6216
			@param aHand
			@param X, Y
			@param aGroupType
			@return Group ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aGroupType groupTypeId
			@kind groupId
		}
		ClosestGroup: function(aHand: Integer; X, Y: Integer; aGroupType: Integer): Integer;

		{
			Returns the group of the specified player and group types that is closest to the specified coordinates,
			or -1 if no such group was found.
			The group types is a "set of Byte", for example [1,3]
			@since 6216
			@param aHand
			@param X, Y
			@param aGroupTypes Set of group types
			@return Group ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind groupId
		}
		ClosestGroupMultipleTypes: function(aHand: Integer; X, Y: Integer; aGroupTypes: TByteSet): Integer;

		{
			Returns the house of the specified player and house type that is closest to the specified coordinates,
			or -1 if no such house was found.
			If the house type is -1 any house type will be accepted
			@since 6216
			@param aHand
			@param X, Y
			@param aHouseType
			@return House ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aHouseType houseTypeId
			@kind houseId
		}
		ClosestHouse: function(aHand: Integer; X, Y: Integer; aHouseType: Integer): Integer;

		{
			Returns the house of the specified player and house types that is closest to the specified coordinates,
			or -1 if no such house was found.
			The house types is a "set of Byte", for example [11,13,21]
			@since 6216
			@param aHand
			@param X, Y
			@param aHouseTypes Set of house types
			@return House ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		ClosestHouseMultipleTypes: function(aHand: Integer; X, Y: Integer; aHouseTypes: TByteSet): Integer;

		{
			Returns the unit of the specified player and unit type that is closest to the specified coordinates,
			or -1 if no such unit was found.
			If the unit type is -1 any unit type will be accepted
			@since 6216
			@param aHand
			@param X, Y
			@param aUnitType
			@return Unit ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aUnitType unitTypeId
			@kind unitId
		}
		ClosestUnit: function(aHand: Integer; X, Y: Integer; aUnitType: Integer): Integer;

		{
			Returns the unit of the specified player and unit types that is closest to the specified coordinates,
			or -1 if no such unit was found.
			The unit types is a "set of Byte", for example [0,9]
			@since 6216
			@param aHand
			@param X, Y
			@param aUnitTypes Set of unit types
			@return Unit ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		ClosestUnitMultipleTypes: function(aHand: Integer; X, Y: Integer; aUnitTypes: TByteSet): Integer;

		{
			Check if two tiles are connected by walkable road
			@since 6602
			@param X1 left coordinate
			@param Y1 top coordinate
			@param X2 right coordinate
			@param Y2 bottom coordinate
			@return Connected
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		ConnectedByRoad: function(X1: Integer; Y1: Integer; X2: Integer; Y2: Integer): Boolean;

		{
			Check if two tiles are connected by a walkable route
			@since 6602
			@param X1 Left coordinate
			@param Y1 Top coordinate
			@param X2 Right coordinate
			@param Y2 Bottom coordinate
			@return Connected
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		ConnectedByWalking: function(X1: Integer; Y1: Integer; X2: Integer; Y2: Integer): Boolean;

		{
			Check if a tile is revealed in fog of war for a player
			@since 5097
			@param aHand
			@param aX, aY
			@return Revealed
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		FogRevealed: function(aHand: Byte; aX, aY: Integer): Boolean;

		{
			Get the number of game ticks since mission start
			@since 5057
			@return Ticks (~10 per second)
			@kind tickCount
		}
		GameTime: function: Cardinal;

		{
			Returns the ID of the group of the unit on the specified tile or -1 if no group exists there
			@since 5057
			@param aX, aY
			@return Group ID
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind groupId
		}
		GroupAt: function(aX, aY: Integer): Integer;

		{
			Returns the number of columns (units per row) of the specified group
			@since 5272
			@param aGroupID
			@return Column count
			@kind aGroupID groupId
		}
		GroupColumnCount: function(aGroupID: Integer): Integer;

		{
			Returns True if the group is dead (all members dead or joined other groups)
			@since 5057
			@param aGroupID
			@return Dead
			@kind aGroupID groupId
		}
		GroupDead: function(aGroupID: Integer): Boolean;

		{
			Returns True if specified group is idle (has no orders/action)
			@since 6523
			@param aGroupID
			@return Idle
			@kind aGroupID groupId
		}
		GroupIdle: function(aGroupID: Integer): Boolean;

		{
			Returns the unit ID of the specified group member.
			Member 0 will be the flag holder, 1...GroupMemberCount-1 will be the other members
			(0
			@since 5057
			@param aGroupID
			@param aMemberIndex
			@return Unit ID
			@kind aGroupID groupId
			@kind unitId
		}
		GroupMember: function(aGroupID: Integer; aMemberIndex: Integer): Integer;

		{
			Returns the total number of members of the specified group
			@since 5057
			@param aGroupID
			@return Member count
			@kind aGroupID groupId
		}
		GroupMemberCount: function(aGroupID: Integer): Integer;

		{
			Returns the owner of the specified group or -1 if Group ID invalid
			@since 5057
			@param aGroupID
			@return Player ID
			@kind aGroupID groupId
			@kind handIndex
		}
		GroupOwner: function(aGroupID: Integer): Integer;

		{
			Returns the type of the specified group or -1 if Group ID invalid
			@since 5932
			@param aGroupID
			@return Group type, values are 0 - melee, 1 - antiHorse, 2 - ranged, 3 - mounted
			@kind aGroupID groupId
			@kind groupTypeId
		}
		GroupType: function(aGroupID: Integer): Integer;

		{
			Returns the ID of the house at the specified location or -1 if no house exists there
			@since 5057
			@param aX, aY
			@return House ID
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind houseId
		}
		HouseAt: function(aX, aY: Integer): Integer;

		{
			Returns X coordinate of Rally Point of specified barracks or 0 if BarracksID is invalid
			@since 6516
			@param aBarracks
			@return X coordinate
			@kind aBarracks houseId
			@kind xCoordinate
		}
		HouseBarracksRallyPointX: function(aBarracks: Integer): Integer;

		{
			Returns Y coordinate of Rally Point of specified barracks or 0 if BarracksID is invalid
			@since 6516
			@param aBarracks
			@return Y coordinate
			@kind aBarracks houseId
			@kind yCoordinate
		}
		HouseBarracksRallyPointY: function(aBarracks: Integer): Integer;

		{
			Returns building progress of the specified house
			@since 6285
			@param aHouseID
			@return Building progress
			@kind aHouseID houseId
		}
		HouseBuildingProgress: function(aHouseID: Integer): Integer;

		{
			Returns True if the specified house can reach the resources that it mines (coal, stone, fish, etc.)
			@since 5993
			@param aHouseID
			@return Reachable
			@kind aHouseID houseId
		}
		HouseCanReachResources: function(aHouseID: Integer): Boolean;

		{
			Returns the damage of the specified house or -1 if House ID invalid
			@since 5057
			@param aHouseID
			@return House damage
			@kind aHouseID houseId
		}
		HouseDamage: function(aHouseID: Integer): Integer;

		{
			Returns True if the specified house has delivery disabled
			@since 5057
			@param aHouseID
			@return Blocked
			@kind aHouseID houseId
		}
		HouseDeliveryBlocked: function(aHouseID: Integer): Boolean;

		{
			Returns True if the house is destroyed
			@since 5057
			@param aHouseID
			@return Destroyed
			@kind aHouseID houseId
		}
		HouseDestroyed: function(aHouseID: Integer): Boolean;

		{
			❌`Deprecated`
			*Method could be removed in the future game versions, use HouseHasWorker instead*
			Returns True if the specified house currently has a worker
			@since 5057
			@param aHouseID
			@return Has worker
			@kind aHouseID houseId
		}
		HouseHasOccupant: function(aHouseID: Integer): Boolean;

		{
			Returns True if the specified house is fully built
			@since 5345
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseIsComplete: function(aHouseID: Integer): Boolean;

		{
			Returns the owner of the specified house or -1 if House ID invalid
			@since 5057
			@param aHouseID
			@return Player ID
			@kind aHouseID houseId
			@kind handIndex
		}
		HouseOwner: function(aHouseID: Integer): Integer;

		{
			Returns the X coordinate of the specified house or -1 if House ID invalid
			@since 5057
			@param aHouseID
			@return X coordinate
			@kind aHouseID houseId
			@kind xCoordinate
		}
		HousePositionX: function(aHouseID: Integer): Integer;

		{
			Returns the Y coordinate of the specified house or -1 if House ID invalid
			@since 5057
			@param aHouseID
			@return Y coordinate
			@kind aHouseID houseId
			@kind yCoordinate
		}
		HousePositionY: function(aHouseID: Integer): Integer;

		{
			Returns True if the specified house has repair enabled
			@since 5057
			@param aHouseID
			@return Repair enabled
			@kind aHouseID houseId
		}
		HouseRepair: function(aHouseID: Integer): Boolean;

		{
			Returns the amount of the specified resource in the specified house
			@since 5057
			@param aHouseID
			@param aResource
			@return Number of resources or -1 if aHouseID is invalid
			@kind aHouseID houseId
			@kind aResource wareTypeId
		}
		HouseResourceAmount: function(aHouseID: Integer; aResource: Integer): Integer;

		{
			Returns the unit type in the specified slot of the school queue.
			Slot 0 is the unit currently training, slots 1..5 are the queue.
			@since 5165
			@param aHouseID
			@param QueueIndex Queue index (0..5)
			@return Unit type
			@kind aHouseID houseId
			@kind unitTypeId
		}
		HouseSchoolQueue: function(aHouseID: Integer; QueueIndex: Integer): Integer;

		{
			Returns True if specified WIP house area is digged
			@since 6510
			@param aHouseID
			@return Digged
			@kind aHouseID houseId
		}
		HouseSiteIsDigged: function(aHouseID: Integer): Boolean;

		{
			Returns the type of the specified house
			@since 5057
			@param aHouseID
			@return House type
			@kind aHouseID houseId
			@kind houseTypeId
		}
		HouseType: function(aHouseID: Integer): Integer;

		{
			Returns max health of the specified house type
			@since 6284
			@param aHouseType
			@return Max health
			@kind aHouseType houseTypeId
		}
		HouseTypeMaxHealth: function(aHouseType: Integer): Integer;

		{
			Returns the the translated name of the specified house type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup which is
			decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 6001
			@param aHouseType
			@return House type name
			@kind aHouseType houseTypeId
		}
		HouseTypeName: function(aHouseType: Byte): AnsiString;

		{
			❌`Deprecated`
			*Method could be removed in the future game versions, use HouseTypeToWorkerType instead*
			Returns the type of unit that should work in the specified type of house, or -1 if no unit should work in it.
			@since 5345
			@param aHouseType
			@return Unit type
			@kind aHouseType houseTypeId
			@kind unitTypeId
		}
		HouseTypeToOccupantType: function(aHouseType: Integer): Integer;

		{
			Returns True if the specified player can build the specified house type (unlocked and allowed).
			@since 6220
			@param aHand
			@param aHouseType
			@return House unlocked
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		HouseUnlocked: function(aHand: Integer; aHouseType: Integer): Boolean;

		{
			Returns True if the specified ware in the specified storehouse or barracks is blocked
			@since 5099
			@param aHouseID
			@param aWareType
			@return Ware blocked
			@kind aHouseID houseId
			@kind aWareType wareTypeId
		}
		HouseWareBlocked: function(aHouseID: Integer; aWareType: Integer): Boolean;

		{
			Returns the number of the specified weapon ordered to be produced in the specified house
			@since 5165
			@param aHouseID
			@param aWareType
			@return Number of ordered weapons
			@kind aHouseID houseId
			@kind aWareType wareTypeId
		}
		HouseWeaponsOrdered: function(aHouseID: Integer; aWareType: Integer): Integer;

		{
			Returns True if the specified woodcutter's hut is on chop-only mode
			@since 5099
			@param aHouseID
			@return Chop-only
			@kind aHouseID houseId
		}
		HouseWoodcutterChopOnly: function(aHouseID: Integer): Boolean;

		{
			Returns True if the specified player has a corn field at the specified location.
			If player index is -1 it will return True if any player has a corn field at the specified tile
			@since 5345
			@param aHand
			@param X, Y
			@return Is field
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		IsFieldAt: function(aHand: ShortInt; X, Y: Integer): Boolean;

		{
			Returns True if the specified player has a road at the specified location.
			If player index is -1 it will return True if any player has a road at the specified tile
			@since 5345
			@param aHand
			@param X, Y
			@return Is road
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		IsRoadAt: function(aHand: ShortInt; X, Y: Integer): Boolean;

		{
			Returns True if the specified player has a winefield at the specified location.
			If player index is -1 it will return True if any player has a winefield at the specified tile
			@since 5345
			@param aHand
			@param X, Y
			@return Is winefield
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		IsWinefieldAt: function(aHand: ShortInt; X, Y: Integer): Boolean;

		{
			Returns a random single (float) such that: 0
			@since 6216
			@return Decimal number 0.0 to 1.0
		}
		KaMRandom: function: Single;

		{
			Returns a random integer Number, such that: 0
			@since 6216
			@param aMax
			@return Number 0 to aMax
		}
		KaMRandomI: function(aMax: Integer): Integer;

		{
			Returns the number of player locations available on the map (including AIs),
			regardless of whether the location was taken in multiplayer (use PlayerEnabled to check if a location is being used)
			@since 6611
			@return Number of locations
		}
		LocationCount: function: Integer;

		{
			Returns the height of the map
			@since 6613
			@return Height
		}
		MapHeight: function: Integer;

		{
			Returns the height of the terrain at the top left corner (vertex) of the tile at the specified XY coordinates.
			@since 6587
			@param X, Y
			@return Height (0..100)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileHeight: function(X, Y: Integer): Integer;

		{
			Returns the terrain object ID on the tile at the specified XY coordinates.
			Object IDs can be seen in the map editor on the objects tab.
			Object 61 is "block walking".
			If there is no object on the tile, the result will be 255.
			@since 6587
			@param X, Y
			@return Object type (0..255)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileObject: function(X, Y: Integer): Integer;

		{
			Returns the rotation of the tile at the specified XY coordinates.
			@since 6587
			@param X, Y
			@return Rotation (0..3)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileRotation: function(X, Y: Integer): Integer;

		{
			Returns the tile type ID of the tile at the specified XY coordinates.
			Tile IDs can be seen by hovering over the tiles on the terrain tiles tab in the map editor.
			@since 6587
			@param X, Y
			@return Tile type (0..597)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileType: function(X, Y: Integer): Integer;

		{
			Returns the width of the map
			@since 6613
			@return Width
		}
		MapWidth: function: Integer;

		{
			Returns type of FromWare in specified market, or -1 if no ware is selected
			@since 6287
			@param aMarketID
			@return Ware type
			@kind aMarketID houseId
			@kind wareTypeId
		}
		MarketFromWare: function(aMarketID: Integer): Integer;

		{
			Returns the factor of resources lost during market trading,
			used to calculate the TradeRatio (see explanation in MarketValue).
			This value is constant within one KaM Remake release, but may change in future KaM Remake releases
			@since 6217
			@return Loss factor
		}
		MarketLossFactor: function: Single;

		{
			Returns trade order amount in specified market
			@since 6287
			@param aMarketID
			@return Order amount
			@kind aMarketID houseId
		}
		MarketOrderAmount: function(aMarketID: Integer): Integer;

		{
			Returns type of ToWare in specified market, or -1 if no ware is selected
			@since 6287
			@param aMarketID
			@return Ware type
			@kind aMarketID houseId
			@kind wareTypeId
		}
		MarketToWare: function(aMarketID: Integer): Integer;

		{
			Returns the relative market value of the specified resource type,
			which is a rough indication of the cost to produce that resource.
			These values are constant within one KaM Remake release, but may change in future KaM Remake releases.
			The TradeRatio is calculated as: MarketLossFactor * MarketValue(To) / (MarketValue(From).
			If the TradeRatio is >= 1, then the number of From resources required to receive 1 To resource is: Round(TradeRatio).
			If the trade ratio is
			@since 6216
			@param aRes
			@return Value
			@kind aRes wareTypeId
		}
		MarketValue: function(aRes: Integer): Single;

		{
			Length of peacetime in ticks (multiplayer)
			@since 5057
			@return Ticks (~10 per second)
			@kind tickCount
		}
		PeaceTime: function: Cardinal;

		{
			Check how player 1 feels towards player 2 (order matters).
			Returns True for ally, False for enemy
			@since 5057
			@param aHand1
			@param aHand2
			@return Allied
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerAllianceCheck: function(aHand1: Byte; aHand2: Byte): Boolean;

		{
			Get players color as text in hex format
			@since 4758
			@param aHand
			@return Player color as text
			@kind aHand handIndex
		}
		PlayerColorText: function(aHand: Byte): AnsiString;

		{
			See if player was defeated
			@since 5057
			@param aHand
			@return Defeated
			@kind aHand handIndex
		}
		PlayerDefeated: function(aHand: Byte): Boolean;

		{
			Will be False if nobody selected that location in multiplayer
			@since 5057
			@param aHand
			@return Enabled
			@kind aHand handIndex
		}
		PlayerEnabled: function(aHand: Byte): Boolean;

		{
			Returns an array with IDs for all the groups of the specified player
			@since 5209
			@param aHand
			@return Array of group IDs
			@kind aHand handIndex
			@kind groupId
		}
		PlayerGetAllGroups: function(aHand: Byte): TIntegerArray;

		{
			Returns an array with IDs for all the houses of the specified player
			@since 5209
			@param aHand
			@return Array of house IDs
			@kind aHand handIndex
			@kind houseId
		}
		PlayerGetAllHouses: function(aHand: Byte): TIntegerArray;

		{
			Returns an array with IDs for all the units of the specified player
			@since 5165
			@param aHand
			@return Array of unit IDs
			@kind aHand handIndex
			@kind unitId
		}
		PlayerGetAllUnits: function(aHand: Byte): TIntegerArray;

		{
			Wherever player is controlled by AI
			@since 5927
			@param aHand
			@return Player is AI
			@kind aHand handIndex
		}
		PlayerIsAI: function(aHand: Byte): Boolean;

		{
			Get name of player as a string (for multiplayer)
			@since 5057
			@param aHand
			@return Player name
			@kind aHand handIndex
		}
		PlayerName: function(aHand: Byte): AnsiString;

		{
			See if player is victorious
			@since 4545
			@param aHand
			@return Victorious
			@kind aHand handIndex
		}
		PlayerVictorious: function(aHand: Byte): Boolean;

		{
			Returns the ware distribution for the specified resource, house and player
			@since 5345
			@param aHand
			@param aWareType
			@param aHouseType
			@return Ware distribution [0..5]
			@kind aHand handIndex
			@kind aWareType wareTypeId
			@kind aHouseType houseTypeId
		}
		PlayerWareDistribution: function(aHand: Byte; aWareType: Byte; aHouseType: Byte): Byte;

		{
			How many defence positions AI player has.
			Useful for scripts like "if not enough positions and too much groups then add a new position"
			@since 6323
			@param aHand
			@return Defence position count
			@kind aHand handIndex
		}
		StatAIDefencePositionsCount: function(aHand: Byte): Integer;

		{
			How many military units player has
			@since 5057
			@param aHand
			@return Army count
			@kind aHand handIndex
		}
		StatArmyCount: function(aHand: Byte): Integer;

		{
			How many citizen player has
			@since 5057
			@param aHand
			@return Citizen count
			@kind aHand handIndex
		}
		StatCitizenCount: function(aHand: Byte): Integer;

		{
			Returns number of specified house types for specified player.
			@since 6328
			@param aHand
			@param aTypes House types eg. [11, 13, 21]
			@return Total number of houses
			@kind aHand handIndex
		}
		StatHouseMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns the total number of the specified house type for the specified player.
			@since 5057
			@param aHand
			@param aHouseType
			@return Number of houses
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		StatHouseTypeCount: function(aHand: Byte; aHouseType: Byte): Integer;

		{
			Specified house type plans count
			@since 6313
			@param aHand
			@param aHouseType
			@return Number of plans
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		StatHouseTypePlansCount: function(aHand: Byte; aHouseType: Byte): Integer;

		{
			How many active players there are.
			@since 5057
			@return Number of players
		}
		StatPlayerCount: function: Integer;

		{
			Returns the number of the specified resource produced by the specified player
			@since 5057
			@param aHand
			@param aResType
			@return Number of produced resources
			@kind aHand handIndex
			@kind aResType wareTypeId
		}
		StatResourceProducedCount: function(aHand: Byte; aResType: Byte): Integer;

		{
			Returns the number of the specified resource types produced by the specified player.
			@since 6331
			@param aHand
			@param aTypes Set of ware types eg. [8, 10, 13, 27] for food
			@return Number of produced resources
			@kind aHand handIndex
		}
		StatResourceProducedMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns the number of units of the specified player
			@since 4289
			@param aHand
			@return Number of units
			@kind aHand handIndex
		}
		StatUnitCount: function(aHand: Byte): Integer;

		{
			Returns the number of the specified unit killed by the specified player
			@since 5057
			@param aHand
			@param aUnitType
			@return Number of killed units
			@kind aHand handIndex
			@kind aUnitType unitTypeId
		}
		StatUnitKilledCount: function(aHand: Byte; aUnitType: Byte): Integer;

		{
			Returns the number of the specified unit types killed by the specified player.
			@since 6331
			@param aHand
			@param aTypes
			@return Set of unit types eg. [0, 5, 13]
			@kind aHand handIndex
		}
		StatUnitKilledMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns the number of the specified unit lost by the specified player
			@since 5057
			@param aHand
			@param aUnitType
			@return Number of lost units
			@kind aHand handIndex
			@kind aUnitType unitTypeId
		}
		StatUnitLostCount: function(aHand: Byte; aUnitType: Byte): Integer;

		{
			Returns the number of the specified unit types lost by the specified player.
			@since 6331
			@param aHand
			@param aTypes Set of unit types eg. [0, 5, 13]
			@return Number of lost units
			@kind aHand handIndex
		}
		StatUnitLostMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns number of specified unit types for specified player.
			@since 6328
			@param aHand
			@param aTypes Set of unit types eg. [0, 5, 13]
			@return Total number of  units
			@kind aHand handIndex
		}
		StatUnitMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns number of specified unit type for specified player
			@since 5057
			@param aHand
			@param aUnitType
			@return Number of units
			@kind aHand handIndex
			@kind aUnitType unitTypeId
		}
		StatUnitTypeCount: function(aHand: Byte; aUnitType: Byte): Integer;

		{
			Returns the ID of the unit on the specified tile or -1 if no unit exists there
			@since 5057
			@param aX, aY
			@return Unit ID
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind unitId
		}
		UnitAt: function(aX, aY: Integer): Integer;

		{
			Returns the ware a serf is carrying, or -1 if the unit is not a serf or is not carrying anything
			@since 5057
			@param aUnitID
			@return Ware type
			@kind aUnitID unitId
			@kind wareTypeId
		}
		UnitCarrying: function(aUnitID: Integer): Integer;

		{
			Returns True if the unit is dead
			@since 5057
			@param aUnitID
			@return Dead
			@kind aUnitID unitId
		}
		UnitDead: function(aUnitID: Integer): Boolean;

		{
			Returns the direction the specified unit is facing
			@since 5165
			@param aUnitID
			@return Direction (0..7)
			@kind aUnitID unitId
			@kind directionId
		}
		UnitDirection: function(aUnitID: Integer): Integer;

		{
			Returns the ID of the house which is the home of the specified unit (house where he works) or -1 if the unit does not have a home
			@since 5997
			@param aUnitID
			@return House ID
			@kind aUnitID unitId
			@kind houseId
		}
		UnitHome: function(aUnitID: Integer): Integer;

		{
			Returns the hunger level of the specified unit as number of ticks until death or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return Hunger level
			@kind aUnitID unitId
			@kind tickCount
		}
		UnitHunger: function(aUnitID: Integer): Integer;

		{
			Returns True if specified unit is idle (has no orders/action)
			@since 6523
			@param aUnitID
			@return Idle
			@kind aUnitID unitId
		}
		UnitIdle: function(aUnitID: Integer): Boolean;

		{
			Gives the hunger level when a unit will try to eat in ticks until death
			@since 5057
			@return Hunger in ticks
			@kind tickCount
		}
		UnitLowHunger: function: Integer;

		{
			Gives the maximum hunger level a unit can have in ticks until death
			@since 5057
			@return Hunger in ticks
			@kind tickCount
		}
		UnitMaxHunger: function: Integer;

		{
			Returns the owner of the specified unit or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return Player ID
			@kind aUnitID unitId
			@kind handIndex
		}
		UnitOwner: function(aUnitID: Integer): Integer;

		{
			Returns the X coordinate of the specified unit or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return X coordinate
			@kind aUnitID unitId
			@kind xCoordinate
		}
		UnitPositionX: function(aUnitID: Integer): Integer;

		{
			Returns the Y coordinate of the specified unit or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return Y coordinate
			@kind aUnitID unitId
			@kind yCoordinate
		}
		UnitPositionY: function(aUnitID: Integer): Integer;

		{
			Returns the group that the specified unit (warrior) belongs to or -1 if it does not belong to a group
			@since 5057
			@param aUnitID
			@return Group ID
			@kind aUnitID unitId
			@kind groupId
		}
		UnitsGroup: function(aUnitID: Integer): Integer;

		{
			Returns the type of the specified unit or -1 if unit id is invalid
			@since 5057
			@param aUnitID
			@return Unit type
			@kind aUnitID unitId
			@kind unitTypeId
		}
		UnitType: function(aUnitID: Integer): Integer;

		{
			Returns the the translated name of the specified unit type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup
			which is decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 6001
			@param aUnitType
			@return Unit type name
			@kind aUnitType unitTypeId
		}
		UnitTypeName: function(aUnitType: Byte): AnsiString;

		{
			Returns the the translated name of the specified ware type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup
			which is decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 6001
			@param aWareType
			@return Ware type name
			@kind aWareType wareTypeId
		}
		WareTypeName: function(aWareType: Byte): AnsiString;

	end;

var
	{
		The States object: queries the game state.
	}
	States: TKMScriptStates;
	{
		Short alias of States.
	}
	S: TKMScriptStates;
