{
	KaM Remake scripting API stubs - Actions (r6720).
	GENERATED by tools/generate_stubs.py from the wiki page Actions-(Mission-Script-Dynamic); do not edit,
	put corrections into tools/overrides/r6720/Actions.script instead.
}

type
	{
		TKMScriptActions: type of the Actions object.
		@hidden
	}
	TKMScriptActions = record
		{
			Sets AI auto attack range.
			AI groups will automatically attack if you are closer than this many tiles.
			@since 6251
			@param aHand
			@param aRange Range (1 to 20)
			@kind aHand handIndex
		}
		AIAutoAttackRange: procedure(aHand: Byte; aRange: Integer);

		{
			Sets whether the AI should build and manage his own village
			@since 5924
			@param aHand
			@param aAuto
			@kind aHand handIndex
		}
		AIAutoBuild: procedure(aHand: Byte; aAuto: Boolean);

		{
			Sets whether the AI should position his soldiers automatically
			@since 5924
			@param aHand
			@param aAuto
			@kind aHand handIndex
		}
		AIAutoDefence: procedure(aHand: Byte; aAuto: Boolean);

		{
			Sets whether the AI should automatically repair damaged buildings
			@since 5932
			@param aHand
			@param aAuto
			@kind aHand handIndex
		}
		AIAutoRepair: procedure(aHand: Byte; aAuto: Boolean);

		{
			Adds a defence position for the specified AI player
			Returns added defence position UID or -1 if it could not be added
			@since 5932
			@param aHand
			@param X, Y
			@param aDir
			@param aGroupType
			@param aRadius
			@param aDefType
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDir directionId
			@kind aGroupType groupTypeId
		}
		AIDefencePositionAdd: function(aHand: Byte; X, Y: Integer; aDir: Byte; aGroupType: Byte; aRadius: Integer; aDefType: Byte): Integer;

		{
			Removes defence position at X, Y
			@since 6309
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		AIDefencePositionRemove: procedure(aHand: Byte; X, Y: Integer);

		{
			Removes all defence positions for specified AI player
			@since 6323
			@param aHand
			@kind aHand handIndex
		}
		AIDefencePositionRemoveAll: procedure(aHand: Byte);

		{
			Sets whether AI should defend units and houses of allies as if they were its own
			@since 6251
			@param aHand
			@param aDefend
			@kind aHand handIndex
		}
		AIDefendAllies: procedure(aHand: Byte; aDefend: Boolean);

		{
			Sets the warriors equip rate for AI.
			@since 5778
			@param aHand
			@param aType type: 0 - leather, 1 - iron
			@param aRate
			@kind aHand handIndex
		}
		AIEquipRate: procedure(aHand: Byte; aType: Byte; aRate: Integer);

		{
			Sets the formation the AI uses for defence positions. Works only for ClassicAI
			@since 5778
			@param aHand
			@param aType
			@param aCount
			@param aColumns
			@kind aHand handIndex
			@kind aType groupTypeId
		}
		AIGroupsFormationSet: procedure(aHand: Byte; aType: Byte; aCount: Integer; aColumns: Integer);

		{
			Sets the number of ticks before the specified AI will start training recruits
			@since 5924
			@param aHand
			@param aDelay
			@kind aHand handIndex
			@kind aDelay tickCount
		}
		AIRecruitDelay: procedure(aHand: Byte; aDelay: Cardinal);

		{
			Sets the number of recruits the AI will keep in each barracks
			@since 5345
			@param aHand
			@param aLimit
			@kind aHand handIndex
		}
		AIRecruitLimit: procedure(aHand: Byte; aLimit: Byte);

		{
			Sets the number of serfs the AI will train per house.
			Can be a decimal (0.25 for 1 serf per 4 houses)
			@since 5924
			@param aHand
			@param aSerfs
			@kind aHand handIndex
		}
		AISerfsPerHouse: procedure(aHand: Byte; aSerfs: Single);

		{
			Sets the maximum number of soldiers the AI will train, or -1 for unlimited
			@since 5932
			@param aHand
			@param aLimit
			@kind aHand handIndex
		}
		AISoldiersLimit: procedure(aHand: Byte; aLimit: Integer);

		{
			Sets the AI start position which is used for targeting AI attacks
			@since 6251
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		AIStartPosition: procedure(aHand: Byte; X, Y: Integer);

		{
			Sets the maximum number of laborers the AI will train
			@since 5924
			@param aHand
			@param aLimit
			@kind aHand handIndex
		}
		AIWorkerLimit: procedure(aHand: Byte; aLimit: Byte);

		{
			Exits cinematic mode
			@since 5938
			@param aHand
			@kind aHand handIndex
		}
		CinematicEnd: procedure(aHand: Byte);

		{
			Pans the center of the player's screen to the given location over a set number of ticks.
			If Duration = 0 then the screen moves instantly.
			@since 5938
			@param aHand
			@param X, Y
			@param Duration
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind Duration tickCount
		}
		CinematicPanTo: procedure(aHand: Byte; X, Y: Integer; Duration: Integer);

		{
			Puts the player in cinematic mode, blocking user input and allowing the screen to be panned
			@since 5938
			@param aHand
			@kind aHand handIndex
		}
		CinematicStart: procedure(aHand: Byte);

		{
			Covers (un-reveals) the entire map in fog of war for player
			@since 5097
			@param aHand
			@kind aHand handIndex
		}
		FogCoverAll: procedure(aHand: Byte);

		{
			Covers a circle in fog of war for player
			@since 5097
			@param aHand
			@param X, Y
			@param aRadius
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		FogCoverCircle: procedure(aHand: Integer; X, Y: Integer; aRadius: Integer);

		{
			Covers a rectangular area in fog of war for player
			Left top corner of the map is 0:0
			Right bottom corner is MapX, MapY (f.e. 255:255)
			@since 5777
			@param aHand
			@param X1 Left coordinate of the 1st tile left top corner vertex
			@param Y1 Top coordinate of the 1st tile left top corner vertex
			@param X2 Right coordinate of the 2nd tile left top corner vertex
			@param Y2 Bottom coordinate of the 2nd tile left top corner vertex
			@kind aHand handIndex
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		FogCoverRect: procedure(aHand: Integer; X1: Integer; Y1: Integer; X2: Integer; Y2: Integer);

		{
			Reveals the entire map in fog of war for player
			@since 5097
			@param aHand
			@kind aHand handIndex
		}
		FogRevealAll: procedure(aHand: Byte);

		{
			Reveals a circle in fog of war for player
			@since 5097
			@param aHand
			@param X, Y
			@param aRadius
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		FogRevealCircle: procedure(aHand: Integer; X, Y: Integer; aRadius: Integer);

		{
			Reveals a rectangular area in fog of war for player
			Left top corner of the map is 0:0
			Right bottom corner is MapX, MapY (f.e. 255:255)
			@since 5777
			@param aHand
			@param X1 Left coordinate of the 1st tile left top corner vertex
			@param Y1 Top coordinate of the 1st tile left top corner vertex
			@param X2 Right coordinate of the 2nd tile left top corner vertex
			@param Y2 Bottom coordinate of the 2nd tile left top corner vertex
			@kind aHand handIndex
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		FogRevealRect: procedure(aHand: Integer; X1: Integer; Y1: Integer; X2: Integer; Y2: Integer);

		{
			Adds an animal to the game and returns the unit ID or -1 if the animal was not able to be added
			@since 5057
			@param aType
			@param X, Y
			@kind aType unitTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		GiveAnimal: function(aType: Integer; X, Y: Integer): Integer;

		{
			Adds finished field and returns True if field was successfully added
			@since 6311
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveField: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Give player group of warriors and return the group ID or -1 if the group was not able to be added
			@since 5057
			@param aHand
			@param aType
			@param X, Y
			@param aDir
			@param aCount
			@param aColumns Units per row
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDir directionId
			@kind groupId
		}
		GiveGroup: function(aHand: Integer; aType: Integer; X, Y: Integer; aDir: Integer; aCount: Integer; aColumns: Integer): Integer;

		{
			Give player a built house and returns the house ID or -1 if the house was not able to be added
			@since 5097
			@param aHand
			@param aHouseType
			@param X, Y
			@kind aHand handIndex
			@kind aHouseType houseTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		GiveHouse: function(aHand: Integer; aHouseType: Integer; X, Y: Integer): Integer;

		{
			Give player a digged house area and returns House ID or -1 if house site was not able to be added.
			If AddMaterials = True, wood and stone will be added
			@since 6288
			@param aHand
			@param aHouseType
			@param X, Y
			@param aAddMaterials
			@kind aHand handIndex
			@kind aHouseType houseTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		GiveHouseSite: function(aHand: Integer; aHouseType: Integer; X, Y: Integer; aAddMaterials: Boolean): Integer;

		{
			Adds finished road and returns True if road was successfully added
			@since 6311
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveRoad: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Give player a single citizen and returns the unit ID or -1 if the unit was not able to be added
			@since 5057
			@param aHand
			@param aType
			@param X, Y
			@param aDir
			@kind aHand handIndex
			@kind aType unitTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDir directionId
			@kind unitId
		}
		GiveUnit: function(aHand: Integer; aType: Integer; X, Y: Integer; aDir: Integer): Integer;

		{
			Adds amount of wares to players 1st Store
			Wares are added to first Store
			@since 5057
			@param aHand
			@param aType
			@param aCount
			@kind aHand handIndex
			@kind aType wareTypeId
		}
		GiveWares: procedure(aHand: Integer; aType: Integer; aCount: Integer);

		{
			Adds amount of weapons to players 1st Barracks
			Weapons are added to first Barracks
			@since 5165
			@param aHand
			@param aType
			@param aCount
			@kind aHand handIndex
			@kind aType wareTypeId
		}
		GiveWeapons: procedure(aHand: Integer; aType: Integer; aCount: Integer);

		{
			Adds finished winefield and returns True if winefield was successfully added
			@since 6311
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveWineField: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Disables (Disable = True) or enables (Disable = False) control over specifed warriors group
			@since 6277
			@param aGroupID
			@param aBlock
			@kind aGroupID groupId
		}
		GroupBlockOrders: procedure(aGroupID: Integer; aBlock: Boolean);

		{
			Sets whether the specified group will alert the player when they become hungry
			(True to disable hunger messages, False to enable them)
			@since 5993
			@param aGroupID
			@param aDisable
			@kind aGroupID groupId
		}
		GroupDisableHungryMessage: procedure(aGroupID: Integer; aDisable: Boolean);

		{
			Set hunger level for all group members
			@since 5993
			@param aGroupID
			@param aHungerLevel Hunger level (ticks until death)
			@kind aGroupID groupId
			@kind aHungerLevel tickCount
		}
		GroupHungerSet: procedure(aGroupID: Integer; aHungerLevel: Integer);

		{
			Kills all members of the specified group
			@since 5993
			@param aGroupID
			@param aSilent
			@kind aGroupID groupId
		}
		GroupKillAll: procedure(aGroupID: Integer; aSilent: Boolean);

		{
			Order the specified group to attack the specified house
			@since 5057
			@param aGroupID
			@param aHouseID
			@kind aGroupID groupId
			@kind aHouseID houseId
		}
		GroupOrderAttackHouse: procedure(aGroupID: Integer; aHouseID: Integer);

		{
			Order the specified group to attack the specified unit
			@since 5057
			@param aGroupID
			@param aUnitID
			@kind aGroupID groupId
			@kind aUnitID unitId
		}
		GroupOrderAttackUnit: procedure(aGroupID: Integer; aUnitID: Integer);

		{
			Order the specified group to request food
			@since 5057
			@param aGroupID
			@kind aGroupID groupId
		}
		GroupOrderFood: procedure(aGroupID: Integer);

		{
			Order the specified group to halt
			@since 5057
			@param aGroupID
			@kind aGroupID groupId
		}
		GroupOrderHalt: procedure(aGroupID: Integer);

		{
			Order the first specified group to link to the second specified group
			@since 5057
			@param aGroupID
			@param aDestGroupID
			@kind aGroupID groupId
			@kind aDestGroupID groupId
		}
		GroupOrderLink: procedure(aGroupID: Integer; aDestGroupID: Integer);

		{
			Order the specified group to split in half.
			Return the newly create group ID or -1 if splitting failed (e.g. only 1 member)
			@since 5057
			@param aGroupID
			@kind aGroupID groupId
			@kind groupId
		}
		GroupOrderSplit: function(aGroupID: Integer): Integer;

		{
			Splits specified unit from the group.
			Returns the newly create group ID or -1 if splitting failed (e.g. only 1 member)
			@since 6338
			@param aGroupID
			@param aUnitID
			@kind aGroupID groupId
			@kind aUnitID unitId
			@kind groupId
		}
		GroupOrderSplitUnit: function(aGroupID: Integer; aUnitID: Integer): Integer;

		{
			Order the specified group to storm attack
			@since 5057
			@param aGroupID
			@kind aGroupID groupId
		}
		GroupOrderStorm: procedure(aGroupID: Integer);

		{
			Order the specified group to walk somewhere
			@since 5057
			@param aGroupID
			@param X, Y
			@param aDirection
			@kind aGroupID groupId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDirection directionId
		}
		GroupOrderWalk: procedure(aGroupID: Integer; X, Y: Integer; aDirection: Integer);

		{
			Sets the number of columns (units per row) for the specified group
			@since 5057
			@param aGroupID
			@param aNumColumns
			@kind aGroupID groupId
		}
		GroupSetFormation: procedure(aGroupID: Integer; aNumColumns: Byte);

		{
			Add all building materials to the specified WIP house area
			@since 6510
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseAddBuildingMaterials: procedure(aHouseID: Integer);

		{
			Add 5 points of building progress to the specified WIP house area
			@since 6297
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseAddBuildingProgress: procedure(aHouseID: Integer);

		{
			Add damage to the specified house
			@since 5057
			@param aHouseID
			@param aDamage
			@kind aHouseID houseId
		}
		HouseAddDamage: procedure(aHouseID: Integer; aDamage: Integer);

		{
			Reduces damage to the specified house
			@since 5441
			@param aHouseID
			@param aRepair
			@kind aHouseID houseId
		}
		HouseAddRepair: procedure(aHouseID: Integer; aRepair: Integer);

		{
			Add wares to the specified house
			@since 5057
			@param aHouseID
			@param aType
			@param aCount
			@kind aHouseID houseId
			@kind aType wareTypeId
		}
		HouseAddWaresTo: procedure(aHouseID: Integer; aType: Integer; aCount: Integer);

		{
			Sets whether the player is allowed to build the specified house.
			Note: The house must still be unlocked normally (e.g. sawmill for farm), use HouseUnlock to override that.
			@since 5057
			@param aHand
			@param aHouseType
			@param aAllowed
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		HouseAllow: procedure(aHand: Integer; aHouseType: Integer; aAllowed: Boolean);

		{
			Equips the specified unit from the specified barracks.
			Returns the number of units successfully equipped.
			@since 5174
			@param aHouseID
			@param aUnitType
			@param aCount
			@kind aHouseID houseId
			@kind aUnitType unitTypeId
		}
		HouseBarracksEquip: function(aHouseID: Integer; aUnitType: Integer; aCount: Integer): Integer;

		{
			Adds a recruit inside the specified barracks
			@since 6125
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseBarracksGiveRecruit: procedure(aHouseID: Integer);

		{
			Sets delivery blocking for the specified house
			@since 5057
			@param aHouseID
			@param aDeliveryBlocked
			@kind aHouseID houseId
		}
		HouseDeliveryBlock: procedure(aHouseID: Integer; aDeliveryBlocked: Boolean);

		{
			Destroys the specified house.
			Silent means the house will not leave rubble or play destroy sound
			@since 5263
			@param aHouseID
			@param aSilent
			@kind aHouseID houseId
		}
		HouseDestroy: procedure(aHouseID: Integer; aSilent: Boolean);

		{
			Sets whether the specified house displays unoccupied messages to the player
			@since 5345
			@param aHouseID
			@param aDisabled
			@kind aHouseID houseId
		}
		HouseDisableUnoccupiedMessage: procedure(aHouseID: Integer; aDisabled: Boolean);

		{
			Enables house repair for the specified house
			@since 5057
			@param aHouseID
			@param aRepairEnabled
			@kind aHouseID houseId
		}
		HouseRepairEnable: procedure(aHouseID: Integer; aRepairEnabled: Boolean);

		{
			Adds the specified unit to the specified school's queue.
			Returns the number of units successfully added to the queue.
			@since 5174
			@param aHouseID
			@param aUnitType
			@param aCount
			@kind aHouseID houseId
			@kind aUnitType unitTypeId
		}
		HouseSchoolQueueAdd: function(aHouseID: Integer; aUnitType: Integer; aCount: Integer): Integer;

		{
			Removes the unit from the specified slot of the school queue.
			Slot 0 is the unit currently training, slots 1..5 are the queue.
			@since 5174
			@param aHouseID
			@param QueueIndex
			@kind aHouseID houseId
		}
		HouseSchoolQueueRemove: procedure(aHouseID: Integer; QueueIndex: Integer);

		{
			Remove wares from the specified house.
			If a serf was on the way to pick up the ware, the serf will abandon his task
			@since 6015
			@param aHouseID
			@param aType
			@param aCount
			@kind aHouseID houseId
			@kind aType wareTypeId
		}
		HouseTakeWaresFrom: procedure(aHouseID: Integer; aType: Integer; aCount: Integer);

		{
			Allows player to build the specified house even if they don't have the house built that normally unlocks it
			(e.g. sawmill for farm).
			Note: Does not override blocked houses, use HouseAllow for that.
			@since 5057
			@param aHand
			@param aHouseType
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		HouseUnlock: procedure(aHand: Integer; aHouseType: Integer);

		{
			Blocks a specific ware in a storehouse or barracks
			@since 5099
			@param aHouseID
			@param aWareType
			@param aBlocked
			@kind aHouseID houseId
			@kind aWareType wareTypeId
		}
		HouseWareBlock: procedure(aHouseID: Integer; aWareType: Integer; aBlocked: Boolean);

		{
			Sets the amount of the specified weapon ordered to be produced in the specified house
			@since 5165
			@param aHouseID
			@param aWareType
			@param aAmount
			@kind aHouseID houseId
			@kind aWareType wareTypeId
		}
		HouseWeaponsOrderSet: procedure(aHouseID: Integer; aWareType: Integer; aAmount: Integer);

		{
			Sets whether a woodcutter's hut is on chop-only mode
			@since 5099
			@param aHouseID
			@param aChopOnly
			@kind aHouseID houseId
		}
		HouseWoodcutterChopOnly: procedure(aHouseID: Integer; aChopOnly: Boolean);

		{
			Writes a line of text to the game log file. Useful for debugging.
			Note that many calls to this procedure will have a noticeable performance impact,
			as well as creating a large log file, so it is recommended you don't use it outside of debugging
			@since 6067
			@param aText
		}
		Log: procedure(aText: AnsiString);

		{
			Sets the height of the terrain at the top left corner (vertex) of the tile at the specified XY coordinates.
			Returns True if the change succeeded or False if it failed.
			The change will fail if it would cause a unit to become stuck or a house to be damaged
			@since 6587
			@param X, Y
			@param Height Height (0..100)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileHeightSet: function(X, Y: Integer; Height: Integer): Boolean;

		{
			Sets the terrain object on the tile at the specified XY coordinates.
			Object IDs can be seen in the map editor on the objects tab.
			Object 61 is "block walking". To set no object, use object type 255.
			Returns True if the change succeeded or False if it failed.
			The change will fail if it would cause a unit to become stuck or a house/field to be damaged
			@since 6587
			@param X, Y
			@param Obj Object type (0..255)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileObjectSet: function(X, Y: Integer; Obj: Integer): Boolean;

		{
			Sets the tile type and rotation at the specified XY coordinates.
			Tile IDs can be seen by hovering over the tiles on the terrain tiles tab in the map editor.
			Returns True if the change succeeded or False if it failed.
			The change will fail if it would cause a unit to become stuck or a house/field to be damaged
			@since 6587
			@param X, Y
			@param aType Tile type (0..255)
			@param aRotation Tile rotation (0..3)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileSet: function(X, Y: Integer; aType: Integer; aRotation: Integer): Boolean;

		{
			Sets the trade in the specified market
			@since 6216
			@param aMarketID
			@param aFrom
			@param aTo
			@param aAmount
			@kind aMarketID houseId
			@kind aFrom wareTypeId
			@kind aTo wareTypeId
		}
		MarketSetTrade: procedure(aMarketID: Integer; aFrom: Integer; aTo: Integer; aAmount: Integer);

		{
			Appends to text overlaid on top left of screen.
			If the player index is -1 it will be appended for all players.
			@since 5333
			@param aHand
			@param aText
			@kind aHand handIndex
		}
		OverlayTextAppend: procedure(aHand: ShortInt; aText: AnsiString);

		{
			Appends to text overlaid on top left of screen with formatted arguments (same as Format function).
			If the player index is -1 it will be appended for all players.
			Params: Array of arguments
			@since 5333
			@param aHand
			@param aText
			@param aParams
			@kind aHand handIndex
		}
		OverlayTextAppendFormatted: procedure(aHand: ShortInt; aText: AnsiString; aParams: array of const);

		{
			Sets text overlaid on top left of screen.
			If the player index is -1 it will be set for all players.
			@since 5333
			@param aHand
			@param aText
			@kind aHand handIndex
		}
		OverlayTextSet: procedure(aHand: ShortInt; aText: AnsiString);

		{
			Sets text overlaid on top left of screen with formatted arguments (same as Format function).
			If the player index is -1 it will be set for all players.
			Params: Array of arguments
			@since 5333
			@param aHand
			@param aText
			@param aParams
			@kind aHand handIndex
		}
		OverlayTextSetFormatted: procedure(aHand: ShortInt; aText: AnsiString; aParams: array of const);

		{
			Adds a corn field plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile blocked)
			@since 5057
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddField: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Adds a house plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile is blocked)
			@since 5057
			@param aHand
			@param aHouseType
			@param X, Y
			@kind aHand handIndex
			@kind aHouseType houseTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddHouse: function(aHand: Integer; aHouseType: Integer; X, Y: Integer): Boolean;

		{
			Adds a road plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile blocked)
			@since 5057
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddRoad: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Adds a wine field plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile blocked)
			@since 5057
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddWinefield: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Connects road plans between two points like AI builder and returns True if road plan was successfully added.
			If CompletedRoad = True, road will be added instead of plans
			@since 6303
			@param aHand
			@param X1 Left coordinate
			@param Y1 Top coordinate
			@param X2 Right coordinate
			@param Y2 Bottom coordinate
			@param aCompleted Completed road
			@kind aHand handIndex
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		PlanConnectRoad: function(aHand: Integer; X1: Integer; Y1: Integer; X2: Integer; Y2: Integer; aCompleted: Boolean): Boolean;

		{
			Removes house, road or field plans from the specified tile for the specified player
			Returns True if the plan was successfully removed or False if it failed (e.g. tile blocked)
			@since 5345
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanRemove: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Add default goals/lost goals for the specified player.
			If the parameter buildings is True the goals will be important buildings.
			Otherwise it will be troops.
			@since 5165
			@param aHand
			@param aBuildings
			@kind aHand handIndex
		}
		PlayerAddDefaultGoals: procedure(aHand: Byte; aBuildings: Boolean);

		{
			Change whether player1 is allied to player2.
			If Compliment is True, then it is set both ways (so also whether player2 is allied to player1)
			@since 5097
			@param aHand1
			@param aHand2
			@param aCompliment Both ways
			@param aAllied
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerAllianceChange: procedure(aHand1: Byte; aHand2: Byte; aCompliment: Boolean; aAllied: Boolean);

		{
			Proclaims player defeated
			@since 5057
			@param aHand
			@kind aHand handIndex
		}
		PlayerDefeat: procedure(aHand: Integer);

		{
			Sets whether player A shares his vision with player B (one way, for both ways use PlayerShareFogCompliment).
			Sharing can still only happen between allied players, but this command lets you disable allies from sharing.
			@since 5345
			@param aHand1
			@param aHand2
			@param aShare
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerShareFog: procedure(aHand1: Integer; aHand2: Integer; aShare: Boolean);

		{
			Sets ware distribution for the specified resource, house and player.
			Note: distribution should be set after 1st tick of the game,
			thus it will not make effect to use it in OnMissionStart event handler
			@since 5345
			@param aHand
			@param aWareType
			@param aHouseType
			@param aAmount Distribution amount (0..5)
			@kind aHand handIndex
			@kind aWareType wareTypeId
			@kind aHouseType houseTypeId
		}
		PlayerWareDistribution: procedure(aHand: Byte; aWareType: Byte; aHouseType: Byte; aAmount: Byte);

		{
			Set specified player(s) victorious, and all team members of those player(s) if the 2nd parameter TeamVictory is set to True.
			All players who were not set to victorious are set to defeated.
			@since 5057
			@param aVictors Array of player IDs
			@param aTeamVictory
		}
		PlayerWin: procedure(aVictors: array of Integer; aTeamVictory: Boolean);

		{
			Plays WAV audio file.
			If the player index is -1 the sound will be played to all players.
			Mono and stereo WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav
			@since 5309
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayWAV: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays WAV audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			Radius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use radius 32).
			Only mono WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav.
			Will not play if the location is not revealed to the player.
			Higher volume range is allowed than PlayWAV as positional sounds are quieter
			@since 5309
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 4.0)
			@param aRadius Radius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayWAVAtLocation: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single; aRadius: Single; aX, aY: Integer): Integer;

		{
			Plays looped WAV audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			aRadius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use aRadius 32).
			Only mono WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav.
			Will not play if the location is not revealed to the player (will start playing automatically when it is revealed).
			Higher aVolume range is allowed than PlayWAV as positional sounds are quieter.
			The sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 6222
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 4.0)
			@param aRadius aRadius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayWAVAtLocationLooped: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single; aRadius: Single; aX, aY: Integer): Integer;

		{
			Same as PlayWAV except music will fade then mute while the WAV is playing, then fade back in afterwards.
			You should leave a small gap at the start of your WAV file to give the music time to fade
			@since 6220
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayWAVFadeMusic: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays looped audio file.
			If the player index is -1 the sound will be played to all players.
			Mono or stereo WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav.
			The sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 6222
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayWAVLooped: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Removes road
			@since 5927
			@param X, Y
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		RemoveRoad: procedure(X, Y: Integer);

		{
			Sets whether the player is allowed to trade the specified resource.
			@since 5057
			@param aHand
			@param aResType
			@param aAllowed
			@kind aHand handIndex
			@kind aResType wareTypeId
		}
		SetTradeAllowed: procedure(aHand: Integer; aResType: Integer; aAllowed: Boolean);

		{
			Displays a message to a player.
			If the player index is -1 the message will be shown to all players.
			@since 5057
			@param aHand
			@param aText
			@kind aHand handIndex
		}
		ShowMsg: procedure(aHand: ShortInt; aText: AnsiString);

		{
			Displays a message to a player with formatted arguments (same as Format function).
			If the player index is -1 the message will be shown to all players.
			@since 5333
			@param aHand
			@param aText
			@param Params Array of arguments
			@kind aHand handIndex
		}
		ShowMsgFormatted: procedure(aHand: ShortInt; aText: AnsiString; Params: array of const);

		{
			Displays a message to a player with a goto button that takes the player to the specified location.
			If the player index is -1 the message will be shown to all players.
			@since 5345
			@param aHand
			@param aX, aY
			@param aText
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		ShowMsgGoto: procedure(aHand: ShortInt; aX, aY: Integer; aText: AnsiString);

		{
			Displays a message to a player with formatted arguments (same as Format function)
			and a goto button that takes the player to the specified location.
			If the player index is -1 the message will be shown to all players.
			@since 5345
			@param aHand
			@param aX, aY
			@param aText
			@param Params Array of arguments
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		ShowMsgGotoFormatted: procedure(aHand: ShortInt; aX, aY: Integer; aText: AnsiString; Params: array of const);

		{
			Stops playing a looped sound that was previously started with either Actions.PlayWAVLooped or Actions.PlayWAVAtLocationLooped.
			@since 6222
			@param aSoundIndex value that was returned by either of those functions when the looped sound was started.
		}
		StopLoopedWAV: procedure(aSoundIndex: Integer);

		{
			Sets whether the specified player can train/equip the specified unit type
			@since 5993
			@param aHand
			@param aType
			@param aBlock
			@kind aHand handIndex
			@kind aType unitTypeId
		}
		UnitBlock: procedure(aHand: Byte; aType: Integer; aBlock: Boolean);

		{
			Makes the specified unit face a certain direction.
			Note: Only works on idle units so as not to interfere with game logic and cause crashes.
			Returns True on success or False on failure.
			@since 5057
			@param aUnitID
			@param aDirection
			@kind aUnitID unitId
			@kind aDirection directionId
		}
		UnitDirectionSet: function(aUnitID: Integer; aDirection: Integer): Boolean;

		{
			Sets the hunger level of the specified unit in ticks until death
			@since 5057
			@param aUnitID
			@param aHungerLevel Hunger level (ticks until death)
			@kind aUnitID unitId
			@kind aHungerLevel tickCount
		}
		UnitHungerSet: procedure(aUnitID: Integer; aHungerLevel: Integer);

		{
			Kills the specified unit.
			Silent means the death animation (ghost) and sound won't play
			@since 5099
			@param aUnitID
			@param aSilent
			@kind aUnitID unitId
		}
		UnitKill: procedure(aUnitID: Integer; aSilent: Boolean);

		{
			Order the specified unit to walk somewhere.
			Note: Only works on idle units so as not to interfere with game logic and cause crashes.
			Returns True on success or False on failure.
			@since 5057
			@param aUnitID
			@param X, Y
			@kind aUnitID unitId
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		UnitOrderWalk: function(aUnitID: Integer; X, Y: Integer): Boolean;

	end;

var
	{
		The Actions object: tells the game what to do.
	}
	Actions: TKMScriptActions;
	{
		Short alias of Actions.
	}
	A: TKMScriptActions;
