		{
			Returns the relative market value of the specified resource type,
			which is a rough indication of the cost to produce that resource.
			These values are constant within one KaM Remake release, but may change in future KaM Remake releases.
			The TradeRatio is calculated as: MarketLossFactor * MarketValue(To) / (MarketValue(From).
			If the TradeRatio is >= 1, then the number of From resources required to receive 1 To resource is: Round(TradeRatio).
			If the trade ratio is
			@since 13900
			@param aWareType
			@return Value
		}
		MarketValueEx: function(aWareType: TKMWareType): Single;

		{
			Returns mission author
			@since 7000
		}
		MissionAuthor: function: UnicodeString;

		{
			Returns mission difficulty for current game
			@since 7000
		}
		MissionDifficulty: function: TKMMissionDifficulty;

		{
			Returns allowed mission difficulty levels
			@since 7000
		}
		MissionDifficultyLevels: function: TKMMissionDifficultySet;

		{
			Returns mission version
			@since 11300
		}
		MissionVersion: function: UnicodeString;

		{
			Length of peacetime in ticks (multiplayer)
			@since 5057
			@return Ticks (~10 per second)
			@kind tickCount
		}
		PeaceTime: function: Cardinal;

		{
			Check how player 1 feels towards player 2 (order matters).
			Returns True for ally, False for enemy
			@since 5057
			@param aHand1
			@param aHand2
			@return Allied
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerAllianceCheck: function(aHand1: Byte; aHand2: Byte): Boolean;

		{
			Get players color in hex format
			@since 10940
			@param aHand
			@return Player color
			@kind aHand handIndex
		}
		PlayerColorFlag: function(aHand: Byte): AnsiString;

		{
			Get players color as text in hex format
			@since 4758
			@param aHand
			@return Player color as text
			@kind aHand handIndex
		}
		PlayerColorText: function(aHand: Byte): AnsiString;

		{
			See if player was defeated
			@since 5057
			@param aHand
			@return Defeated
			@kind aHand handIndex
		}
		PlayerDefeated: function(aHand: Byte): Boolean;

		{
			Will be False if nobody selected that location in multiplayer
			@since 5057
			@param aHand
			@return Enabled
			@kind aHand handIndex
		}
		PlayerEnabled: function(aHand: Byte): Boolean;

		{
			Returns an array with IDs for all the groups of the specified player
			@since 5209
			@param aHand
			@return Array of group IDs
			@kind aHand handIndex
			@kind groupId
		}
		PlayerGetAllGroups: function(aHand: Byte): TIntegerArray;

		{
			Returns an array with IDs for all the houses of the specified player
			@since 5209
			@param aHand
			@return Array of house IDs
			@kind aHand handIndex
			@kind houseId
		}
		PlayerGetAllHouses: function(aHand: Byte): TIntegerArray;

		{
			Returns an array with IDs for all the units of the specified player
			@since 5165
			@param aHand
			@return Array of unit IDs
			@kind aHand handIndex
			@kind unitId
		}
		PlayerGetAllUnits: function(aHand: Byte): TIntegerArray;

		{
			Returns True if the specified player can build the specified house type
			@since 14600
			@param aHand
			@param aHouseType
			@return House can be build
			@kind aHand handIndex
		}
		PlayerHouseTypeCanBuild: function(aHand: Integer; aHouseType: TKMHouseType): Boolean;

		{
			Returns player house type lock as enum value of TKMHandHouseLock = (hlDefault, hlBlocked, hlGranted)
			@since 14600
			@param aHand
			@param aHouseType
			@return Player house type lock
			@kind aHand handIndex
		}
		PlayerHouseTypeLock: function(aHand: Integer; aHouseType: TKMHouseType): TKMHandHouseLock;

		{
			Wherever player is controlled by Advanced AI
			@since 14600
			@param aHand
			@return Player is Advanced AI
			@kind aHand handIndex
		}
		PlayerIsAdvancedAI: function(aHand: Byte): Boolean;

		{
			Wherever player is controlled by AI
			@since 5927
			@param aHand
			@return Player is AI
			@kind aHand handIndex
		}
		PlayerIsAI: function(aHand: Byte): Boolean;

		{
			Get name of player as a string (for multiplayer)
			@since 5057
			@param aHand
			@return Player name
			@kind aHand handIndex
		}
		PlayerName: function(aHand: Byte): AnsiString;

		{
			Returns True if the specified player can train / equip the specified unit type
			@since 14600
			@param aHand
			@param aUnitType
			@return Unit could be trained / equipped
			@kind aHand handIndex
		}
		PlayerUnitTypeCanTrain: function(aHand: Integer; aUnitType: TKMUnitType): Boolean;

		{
			See if player is victorious
			@since 4545
			@param aHand
			@return Victorious
			@kind aHand handIndex
		}
		PlayerVictorious: function(aHand: Byte): Boolean;

		{
			Returns the ware distribution for the specified resource, house and player
			@since 5345
			@deprecated Use PlayerWareDistributionEx instead
			@param aHand
			@param aWareType
			@param aHouseType
			@return Ware distribution [0..5]
			@kind aHand handIndex
			@kind aWareType wareTypeId
			@kind aHouseType houseTypeId
		}
		PlayerWareDistribution: function(aHand: Byte; aWareType: Byte; aHouseType: Byte): Byte;

		{
			Returns the ware distribution for the specified resource, house and player
			@since 14600
			@param aHand
			@param aWareType
			@param aHouseType
			@return Ware distribution [0..5]
			@kind aHand handIndex
		}
		PlayerWareDistributionEx: function(aHand: Integer; aWareType: TKMWareType; aHouseType: TKMHouseType): Integer;

		{
			How many defence positions AI player has.
			Useful for scripts like "if not enough positions and too much groups then add a new position"
			@since 6323
			@param aHand
			@return Defence position count
			@kind aHand handIndex
		}
		StatAIDefencePositionsCount: function(aHand: Byte): Integer;

		{
			How many military units player has
			@since 5057
			@param aHand
			@return Army count
			@kind aHand handIndex
		}
		StatArmyCount: function(aHand: Byte): Integer;

		{
			The power factor of a player's army
			@since 13660
			@param aHand
			@return Army power
			@kind aHand handIndex
		}
		StatArmyPower: function(aHand: Byte): Single;

		{
			How many citizen player has
			@since 5057
			@param aHand
			@return Citizen count
			@kind aHand handIndex
		}
		StatCitizenCount: function(aHand: Byte): Integer;

		{
			Returns the number of houses of the specified player
			@since 10940
			@param aHand
			@return Number of houses
			@kind aHand handIndex
		}
		StatHouseCount: function(aHand: Byte): Integer;

		{
			Returns number of specified house types for specified player.
			@since 6328
			@deprecated Use StatHouseMultipleTypesCountEx instead
			@param aHand
			@param aTypes House types eg. [11, 13, 21]
			@return Total number of houses
			@kind aHand handIndex
		}
		StatHouseMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns number of specified house types for specified player.
			@since 13900
			@param aHand
			@param aTypes House types eg. [htQuary, htSchool, htStore]
			@return Total number of houses
			@kind aHand handIndex
		}
		StatHouseMultipleTypesCountEx: function(aHand: Integer; aTypes: TKMHouseTypeSet): Integer;

		{
			Returns the total number of the specified house type for the specified player.
			@since 5057
			@deprecated Use StatHouseTypeCountEx instead
			@param aHand
			@param aHouseType
			@return Number of houses
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		StatHouseTypeCount: function(aHand: Byte; aHouseType: Byte): Integer;

		{
			Returns the total number of the specified house type for the specified player.
			@since 13900
			@param aHand
			@param aHouseType
			@return Number of houses
			@kind aHand handIndex
		}
		StatHouseTypeCountEx: function(aHand: Integer; aHouseType: TKMHouseType): Integer;

		{
			Specified house type plans count
			@since 6313
			@deprecated Use StatHouseTypePlansCountEx instead
			@param aHand
			@param aHouseType
			@return Number of plans
			@kind aHand handIndex
			@kind aHouseType houseTypeId
		}
		StatHouseTypePlansCount: function(aHand: Byte; aHouseType: Byte): Integer;

		{
			Specified house type plans count
			@since 13900
			@param aHand
			@param aHouseType
			@return Number of plans
			@kind aHand handIndex
		}
		StatHouseTypePlansCountEx: function(aHand: Integer; aHouseType: TKMHouseType): Integer;

		{
			How many active players there are.
			@since 5057
			@return Number of players
		}
		StatPlayerCount: function: Integer;

		{
			Returns the number of the specified resource produced by the specified player
			@since 5057
			@deprecated Use StatResourceProducedCountEx instead
			@param aHand
			@param aResType
			@return Number of produced resources
			@kind aHand handIndex
			@kind aResType wareTypeId
		}
		StatResourceProducedCount: function(aHand: Byte; aResType: Byte): Integer;

		{
			Returns the number of the specified resource produced by the specified player
			if wtFood is passed, then all produced food will be returned
			if wtWarfare is passed, then all produced warfare will be returned, including horses
			if wtAll is passed, then all produced wares will be returned
			@since 13900
			@param aHand
			@param aWareType
			@return Number of produced resources
			@kind aHand handIndex
		}
		StatResourceProducedCountEx: function(aHand: Integer; aWareType: TKMWareType): Integer;

		{
			Returns the number of the specified resource types produced by the specified player.
			@since 6331
			@deprecated Use StatResourceProducedMultipleTypesCountEx instead
			@param aHand
			@param aTypes Set of ware types eg. [8, 10, 13, 27] for food
			@return Number of produced resources
			@kind aHand handIndex
		}
		StatResourceProducedMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns the number of the specified resource types produced by the specified player.
			@since 13900
			@param aHand
			@param aTypes Set of ware types eg. [wtCoal, wtIron, wtGold]
			@return Number of produced resources
			@kind aHand handIndex
		}
		StatResourceProducedMultipleTypesCountEx: function(aHand: Integer; aTypes: TKMWareTypeSet): Integer;

		{
			Returns the number of units of the specified player
			@since 4289
			@param aHand
			@return Number of units
			@kind aHand handIndex
		}
		StatUnitCount: function(aHand: Byte): Integer;

		{
			Returns the number of the specified unit killed by the specified player
			@since 5057
			@deprecated Use StatUnitKilledCountEx instead
			@param aHand
			@param aUnitType
			@return Number of killed units
			@kind aHand handIndex
			@kind aUnitType unitTypeId
		}
		StatUnitKilledCount: function(aHand: Byte; aUnitType: Byte): Integer;

		{
			Returns the number of the specified unit killed by the specified player
			if utAny is passed, then return all killed units by the specified player
			@since 13900
			@param aHand
			@param aUnitType
			@return Number of killed units
			@kind aHand handIndex
		}
		StatUnitKilledCountEx: function(aHand: Integer; aUnitType: TKMUnitType): Integer;

		{
			Returns the number of the specified unit types killed by the specified player.
			@since 6331
			@deprecated Use StatUnitKilledMultipleTypesCountEx instead
			@param aHand
			@param aTypes
			@return Set of unit types eg. [0, 5, 13]
			@kind aHand handIndex
		}
		StatUnitKilledMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns the number of the specified unit types killed by the specified player.
			@since 13900
			@param aHand
			@param aTypes
			@return Set of unit types eg. [utMilitia, utAxeFighter, utSwordFighter]
			@kind aHand handIndex
		}
		StatUnitKilledMultipleTypesCountEx: function(aHand: Integer; aTypes: TKMUnitTypeSet): Integer;

		{
			Returns the number of the specified unit lost by the specified player
			@since 5057
			@deprecated Use StatUnitLostCountEx instead
			@param aHand
			@param aUnitType
			@return Number of lost units
			@kind aHand handIndex
			@kind aUnitType unitTypeId
		}
		StatUnitLostCount: function(aHand: Byte; aUnitType: Byte): Integer;

		{
			Returns the number of the specified unit lost by the specified player
			if utAny is passed, then return number of all lost units by the specified player
			@since 13900
			@param aHand
			@param aUnitType
			@return Number of lost units
			@kind aHand handIndex
		}
		StatUnitLostCountEx: function(aHand: Integer; aUnitType: TKMUnitType): Integer;

		{
			Returns the number of the specified unit types lost by the specified player.
			@since 6331
			@deprecated Use StatUnitLostMultipleTypesCountEx instead
			@param aHand
			@param aTypes Set of unit types eg. [0, 5, 13]
			@return Number of lost units
			@kind aHand handIndex
		}
		StatUnitLostMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns the number of the specified unit types lost by the specified player.
			@since 13900
			@param aHand
			@param aTypes Set of unit types eg. [utMilitia, utAxeFighter, utSwordFighter]
			@return Number of lost units
			@kind aHand handIndex
		}
		StatUnitLostMultipleTypesCountEx: function(aHand: Byte; aTypes: TKMUnitTypeSet): Integer;

		{
			Returns number of specified unit types for specified player.
			@since 6328
			@deprecated Use StatUnitMultipleTypesCountEx instead
			@param aHand
			@param aTypes Set of unit types eg. [0, 5, 13]
			@return Total number of  units
			@kind aHand handIndex
		}
		StatUnitMultipleTypesCount: function(aHand: Byte; aTypes: TByteSet): Integer;

		{
			Returns number of specified unit types for specified player.
			@since 13900
			@param aHand
			@param aTypes Set of unit types eg. [utSerf, utMilitia]
			@return Total number of  units
			@kind aHand handIndex
		}
		StatUnitMultipleTypesCountEx: function(aHand: Integer; aTypes: TKMUnitTypeSet): Integer;

		{
			Returns number of specified unit type for specified player
			@since 5057
			@deprecated Use StatUnitTypeCountEx instead
			@param aHand
			@param aUnitType
			@return Number of units
			@kind aHand handIndex
			@kind aUnitType unitTypeId
		}
		StatUnitTypeCount: function(aHand: Byte; aUnitType: Byte): Integer;

		{
			Returns number of specified unit type for specified player
			if passed utAny as unit type, then returns number of all units for the specified player
			@since 13900
			@param aHand
			@param aUnitType
			@return Number of units
			@kind aHand handIndex
		}
		StatUnitTypeCountEx: function(aHand: Integer; aUnitType: TKMUnitType): Integer;

		{
			Return if specified unit is allowed to be selected and viewed by his allies
			For warriors returns if allies can select their group
			@since 12600
			@param aUnitID
			@kind aUnitID unitId
		}
		UnitAllowAllyToSelect: function(aUnitID: Integer): Boolean;

		{
			Returns the ID of the unit on the specified tile or -1 if no unit exists there
			@since 5057
			@param aX, aY
			@return Unit ID
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind unitId
		}
		UnitAt: function(aX, aY: Integer): Integer;

		{
			Returns the ware a serf is carrying, or -1 if the unit is not a serf or is not carrying anything
			@since 5057
			@deprecated Use UnitCarryingEx instead
			@param aUnitID
			@return Ware type
			@kind aUnitID unitId
			@kind wareTypeId
		}
		UnitCarrying: function(aUnitID: Integer): Integer;

		{
			Returns the ware a serf is carrying, or wtNone if the unit is not a serf or is not carrying anything
			@since 13900
			@param aUnitID
			@return Ware type
			@kind aUnitID unitId
		}
		UnitCarryingEx: function(aUnitID: Integer): TKMWareType;

		{
			Returns True if the unit is dead
			@since 5057
			@param aUnitID
			@return Dead
			@kind aUnitID unitId
		}
		UnitDead: function(aUnitID: Integer): Boolean;

		{
			Returns the direction the specified unit is facing
			@since 5165
			@deprecated Use UnitDirectionEx instead
			@param aUnitID
			@return Direction (0..7)
			@kind aUnitID unitId
			@kind directionId
		}
		UnitDirection: function(aUnitID: Integer): Integer;

		{
			Returns the direction the specified unit is facing
			@since 13900
			@param aUnitID
			@return Direction (dirNA, dirN, dirNE, dirE, dirSE, dirS, dirSW, dirW, dirNW)
			@kind aUnitID unitId
		}
		UnitDirectionEx: function(aUnitID: Integer): TKMDirection;

		{
			Returns the 'Dismissable' status of specified unit
			@since 7000
			@param aUnitID
			@return is unit dismissable
			@kind aUnitID unitId
		}
		UnitDismissable: function(aUnitID: Integer): Boolean;

		{
			Returns number of available fish to catch on the specified fish unit
			@since 15000
			@param aUnitID
			@kind aUnitID unitId
		}
		UnitFishCount: function(aUnitID: Integer): Integer;

		{
			Returns the ID of the house which is the home of the specified unit (house where he works) or -1 if the unit does not have a home
			@since 5997
			@param aUnitID
			@return House ID
			@kind aUnitID unitId
			@kind houseId
		}
		UnitHome: function(aUnitID: Integer): Integer;

		{
			Returns current hitpoints for specified unit or -1 if Unit ID invalid
			@since 7000
			@param aUnitID
			@return HitPoints
			@kind aUnitID unitId
		}
		UnitHPCurrent: function(aUnitID: Integer): Integer;

		{
			See if unit is invulnerable
			@since 7000
			@param aUnitID
			@return True or False
			@kind aUnitID unitId
		}
		UnitHPInvulnerable: function(aUnitID: Integer): Boolean;

		{
			Returns max hitpoints for specified unit or -1 if Unit ID invalid
			@since 7000
			@param aUnitID
			@return HitPoints
			@kind aUnitID unitId
		}
		UnitHPMax: function(aUnitID: Integer): Integer;

		{
			Returns the hunger level of the specified unit as number of ticks until death or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return Hunger level
			@kind aUnitID unitId
			@kind tickCount
		}
		UnitHunger: function(aUnitID: Integer): Integer;

		{
			Returns True if specified unit is idle (has no orders/action)
			@since 6523
			@param aUnitID
			@return Idle
			@kind aUnitID unitId
		}
		UnitIdle: function(aUnitID: Integer): Boolean;

		{
			Returns HouseID where specified Unit is now, at this particular moment, or -1 if Unit not found or Unit is not in any house
			@since 12982
			@param aUnitID
			@return HouseId, where unit is placed
			@kind aUnitID unitId
			@kind houseId
		}
		UnitInHouse: function(aUnitID: Integer): Integer;

		{
			Gives the hunger level when a unit will try to eat in ticks until death
			@since 5057
			@return Hunger in ticks
			@kind tickCount
		}
		UnitLowHunger: function: Integer;

		{
			Gives the maximum hunger level a unit can have in ticks until death
			@since 5057
			@return Hunger in ticks
			@kind tickCount
		}
		UnitMaxHunger: function: Integer;

		{
			Returns the owner of the specified unit or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return Player ID
			@kind aUnitID unitId
			@kind handIndex
		}
		UnitOwner: function(aUnitID: Integer): Integer;

		{
			Returns the TKMPoint with coordinates of the specified unit or (-1;-1) point if Unit ID invalid
			@since 7000
			@param aUnitID
			@return TKMPoint
			@kind aUnitID unitId
		}
		UnitPosition: function(aUnitID: Integer): TKMPoint;

		{
			Returns the X coordinate of the specified unit or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return X coordinate
			@kind aUnitID unitId
			@kind xCoordinate
		}
		UnitPositionX: function(aUnitID: Integer): Integer;

		{
			Returns the Y coordinate of the specified unit or -1 if Unit ID invalid
			@since 5057
			@param aUnitID
			@return Y coordinate
			@kind aUnitID unitId
			@kind yCoordinate
		}
		UnitPositionY: function(aUnitID: Integer): Integer;

		{
			Returns the group that the specified unit (warrior) belongs to or -1 if it does not belong to a group
			@since 5057
			@param aUnitID
			@return Group ID
			@kind aUnitID unitId
			@kind groupId
		}
		UnitsGroup: function(aUnitID: Integer): Integer;

		{
			Returns the type of the specified unit or -1 if unit id is invalid
			@since 5057
			@deprecated Use UnitTypeEx instead
			@param aUnitID
			@return Unit type
			@kind aUnitID unitId
			@kind unitTypeId
		}
		UnitType: function(aUnitID: Integer): Integer;

		{
			Returns the type of the specified unit or utNone if unit id is invalid
			@since 13900
			@param aUnitID
			@return Unit type
			@kind aUnitID unitId
		}
		UnitTypeEx: function(aUnitID: Integer): TKMUnitType;

		{
			Returns the the translated name of the specified unit type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup
			which is decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 6001
			@deprecated Use UnitTypeNameEx instead
			@param aUnitType
			@return Unit type name
			@kind aUnitType unitTypeId
		}
		UnitTypeName: function(aUnitType: Byte): AnsiString;

		{
			Returns the the translated name of the specified unit type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup
			which is decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 13900
			@param aUnitType
			@return Unit type name
		}
		UnitTypeNameEx: function(aUnitType: TKMUnitType): AnsiString;

		{
			Returns the the translated name of the specified ware type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup
			which is decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 6001
			@deprecated Use WareTypeNameEx instead
			@param aWareType
			@return Ware type name
			@kind aWareType wareTypeId
		}
		WareTypeName: function(aWareType: Byte): AnsiString;

		{
			Returns the the translated name of the specified ware type.
			Note: To ensure multiplayer consistency the name is returned as a number encoded within a markup
			which is decoded on output, not the actual translated text.
			Therefore string operations like LowerCase will not work.
			@since 13900
			@param aWareType
			@return Ware type name
		}
		WareTypeNameEx: function(aWareType: TKMWareType): AnsiString;

		{
			Returns True if specified warrior is in fight
			@since 7000
			@param aUnitID
			@param aCountCitizens including fights with citizens
			@return InFight
			@kind aUnitID unitId
		}
		WarriorInFight: function(aUnitID: Integer; aCountCitizens: Boolean): Boolean;

	end;

var
	{
		The States object: queries the game state.
	}
	States: TKMScriptStates;
	{
		Short alias of States.
	}
	S: TKMScriptStates;
