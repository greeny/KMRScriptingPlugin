{
	KaM Remake scripting API stubs - States (r16020).
	GENERATED by tools/generate_stubs.py from the wiki page States-(Mission-Script-Dynamic); do not edit,
	put corrections into tools/overrides/r16020/States.script instead.
}

type
	{
		TKMScriptStates: type of the States object.
		@hidden
	}
	TKMScriptStates = record
		{
			Gets set of house types, houses of which Advanced AI should attack
			Returns empty set if wrong handId was passed
			@since 14600
			@param aHand HandID
			@kind aHand handIndex
		}
		AAIAttackHouseTypesGet: function(aHand: Byte): TKMHouseTypeSet;

		{
			Gets AI army type
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIArmyType: function(aHand: Byte): TKMArmyType;

		{
			Gets AI AutoAttack (True or False)
			@since 13000
			@param aHand
			@kind aHand handIndex
		}
		AIAutoAttack: function(aHand: Byte): Boolean;

		{
			Gets AI auto attack range.
			Returns -1 if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIAutoAttackRange: function(aHand: Byte): Integer;

		{
			Gets whether the AI should build and manage his own village
			Returns False if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIAutoBuild: function(aHand: Byte): Boolean;

		{
			Gets whether the AI should position his soldiers automatically
			Returns False if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIAutoDefence: function(aHand: Byte): Boolean;

		{
			Gets whether the AI should automatically repair damaged buildings
			Returns False if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIAutoRepair: function(aHand: Byte): Boolean;

		{
			Gets the parameters of AI defence position
			Parameters are returned in aX, aY, aGroupType, aRadius, aDefType variables
			Group types: 0 = Melee; 1	= Anti-horse; 2	= Ranged; 3	= Mounted
			Defence type: 0 = Defenders; 1 = Attackers
			@since 12000
			@param aHand
			@param aID
			@param aX, aY
			@param aGroupType
			@param aRadius
			@param aDefType
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind aGroupType groupTypeId
		}
		AIDefencePositionGet: procedure(aHand: Byte; aID: Byte; out aX, aY: Integer; out aGroupType: Byte; out aRadius: Integer; out aDefType: Byte);

		{
			Gets the parameters of AI defence position
			Returns defence position parameters
			@since 13900
			@param aHand
			@param aIndex index in the list of all defence positions for the specified player
			@kind aHand handIndex
		}
		AIDefencePositionGetByIndex: function(aHand: Integer; aIndex: Integer): TKMDefencePositionInfo;

		{
			Gets whether AI should defend units and houses of allies as if they were its own
			Returns False if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIDefendAllies: function(aHand: Byte): Boolean;

		{
			Gets the warriors equip rate for AI.
			Returns -1 if used with wrong parameters
			@since 7000
			@param aHand
			@param aType type: 0 - leather, 1 - iron
			@kind aHand handIndex
		}
		AIEquipRate: function(aHand: Byte; aType: Byte): Integer;

		{
			Gets the formation the AI uses for defence positions for specified player and group type
			GroupType: 0 = Melee, 1 = AntiHorse, 2 = Ranged, 3 = Mounted
			group count and columns are returned in aCount and aColumns variables
			@since 7000
			@deprecated Use AIGroupsFormationGetEx instead
			@param aHand
			@param aType
			@param aCount
			@param aColumns
			@kind aHand handIndex
			@kind aType groupTypeId
		}
		AIGroupsFormationGet: procedure(aHand: Byte; aType: Byte; out aCount: Integer; out aColumns: Integer);

		{
			Gets the formation the AI uses for defence positions for specified player and group type
			group count and columns are returned in aCount and aColumns variables
			@since 13900
			@param aHand
			@param aGroupType
			@param aCount
			@param aColumns
			@kind aHand handIndex
		}
		AIGroupsFormationGetEx: procedure(aHand: Integer; aGroupType: TKMGroupType; out aCount: Integer; out aColumns: Integer);

		{
			Gets the number of ticks before the specified AI will start training recruits
			Returns -1 if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIRecruitDelay: function(aHand: Byte): Integer;

		{
			Gets the number of recruits the AI will keep in each barracks
			Returns -1 if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIRecruitLimit: function(aHand: Byte): Integer;

		{
			Gets whether the AI should automatically repair damaged buildings
			Returns rmNone if used with wrong parameters
			rmNever if disable repair for all houses
			rmAlways if enable repair for all houses
			rmManual if repair is set by script manually via Actions.HouseRepairEnable
			@since 13900
			@param aHand
			@kind aHand handIndex
		}
		AIRepairMode: function(aHand: Integer): TKMAIRepairMode;

		{
			Gets the number of serfs the AI will train per house.
			Can be a decimal (0.25 for 1 serf per 4 houses)
			Returns -1 if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AISerfsPerHouse: function(aHand: Byte): Single;

		{
			Gets the maximum number of soldiers the AI will train, or -1 for unlimited
			Returns -2 if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AISoldiersLimit: function(aHand: Byte): Integer;

		{
			Gets the AI start position which is used for targeting AI attacks
			Returns (-1;-1) if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIStartPosition: function(aHand: Byte): TKMPoint;

		{
			Gets AI unlimited equip parameter or False if aHand parameter is not valid
			@since 14800
			@param aHand
			@kind aHand handIndex
		}
		AIUnlimitedEquip: function(aHand: Byte): Boolean;

		{
			Gets the maximum number of laborers the AI will train
			Returns -1 if used with wrong parameters
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIWorkerLimit: function(aHand: Byte): Integer;

		{
			Returns current campaing mission number or -1 if this is not a campaign mission
			First mission got ID = 1
			@since 12600
		}
		CampaignMissionID: function: Integer;

		{
			Returns current campaign missions count or -1 if this is not a campaign mission
			@since 12600
		}
		CampaignMissionsCount: function: Integer;

		{
			Returns the group of the specified player and group type that is closest to the specified coordinates,
			or -1 if no such group was found.
			If the group type is -1 any group type will be accepted
			@since 6216
			@deprecated Use ClosestGroupEx instead
			@param aHand
			@param X, Y
			@param aGroupType
			@return Group ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aGroupType groupTypeId
			@kind groupId
		}
		ClosestGroup: function(aHand: Integer; X, Y: Integer; aGroupType: Integer): Integer;

		{
			Returns the group of the specified player and group type that is closest to the specified coordinates,
			or -1 if no such group was found.
			@since 13900
			@param aHand
			@param X, Y
			@param aGroupType
			@return Group ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind groupId
		}
		ClosestGroupEx: function(aHand: Integer; X, Y: Integer; aGroupType: TKMGroupType): Integer;

		{
			Returns the group of the specified player and group types that is closest to the specified coordinates,
			or -1 if no such group was found.
			The group types is a "set of Byte", for example [1,3]
			@since 6216
			@deprecated Use ClosestGroupMultipleTypesEx instead
			@param aHand
			@param X, Y
			@param aGroupTypes Set of group types
			@return Group ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind groupId
		}
		ClosestGroupMultipleTypes: function(aHand: Integer; X, Y: Integer; aGroupTypes: TByteSet): Integer;

		{
			Returns the group of the specified player and group types that is closest to the specified coordinates,
			or -1 if no such group was found.
			The group types is a "set of Byte", for example [1,3]
			@since 13900
			@param aHand
			@param X, Y
			@param aGroupTypes Set of group types
			@return Group ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind groupId
		}
		ClosestGroupMultipleTypesEx: function(aHand: Integer; X, Y: Integer; aGroupTypes: TKMGroupTypeSet): Integer;

		{
			Returns the house of the specified player and house type that is closest to the specified coordinates,
			or -1 if no such house was found.
			If the house type is -1 any house type will be accepted
			@since 6216
			@deprecated Use ClosestHouseEx instead
			@param aHand
			@param X, Y
			@param aHouseType
			@return House ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aHouseType houseTypeId
			@kind houseId
		}
		ClosestHouse: function(aHand: Integer; X, Y: Integer; aHouseType: Integer): Integer;

		{
			Returns the house of the specified player and house type that is closest to the specified coordinates,
			or -1 if no such house was found.
			If the house type is htAny any house type will be accepted
			@since 13900
			@param aHand
			@param X, Y
			@param aHouseType
			@return House ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		ClosestHouseEx: function(aHand: Integer; X, Y: Integer; aHouseType: TKMHouseType): Integer;

		{
			Returns the house of the specified player and house types that is closest to the specified coordinates,
			or -1 if no such house was found.
			The house types is a "set of Byte", for example [11,13,21]
			@since 6216
			@deprecated Use ClosestHouseMultipleTypesEx instead
			@param aHand
			@param X, Y
			@param aHouseTypes Set of house types
			@return House ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		ClosestHouseMultipleTypes: function(aHand: Integer; X, Y: Integer; aHouseTypes: TByteSet): Integer;

		{
			Returns the house of the specified player and house types that is closest to the specified coordinates,
			or -1 if no such house was found.
			The house types is a "set of TKMHouseType", for example [htQuary, htSchool, htStore]
			@since 13900
			@param aHand
			@param X, Y
			@param aHouseTypes Set of house types
			@return House ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		ClosestHouseMultipleTypesEx: function(aHand: Integer; X, Y: Integer; aHouseTypes: TKMHouseTypeSet): Integer;

		{
			Returns the unit of the specified player and unit type that is closest to the specified coordinates,
			or -1 if no such unit was found.
			If the unit type is -1 any unit type will be accepted
			@since 6216
			@deprecated Use ClosestUnitEx instead
			@param aHand
			@param X, Y
			@param aUnitType
			@return Unit ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aUnitType unitTypeId
			@kind unitId
		}
		ClosestUnit: function(aHand: Integer; X, Y: Integer; aUnitType: Integer): Integer;

		{
			Returns the unit of the specified player and unit type that is closest to the specified coordinates,
			or -1 if no such unit was found.
			If the unit type is utAny any unit type will be accepted
			@since 13900
			@param aHand
			@param X, Y
			@param aUnitType
			@return Unit ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		ClosestUnitEx: function(aHand: Integer; X, Y: Integer; aUnitType: TKMUnitType): Integer;

		{
			Returns the unit of the specified player and unit types that is closest to the specified coordinates,
			or -1 if no such unit was found.
			The unit types is a "set of Byte", for example [0,9]
			@since 6216
			@deprecated Use ClosestUnitMultipleTypesEx instead
			@param aHand
			@param X, Y
			@param aUnitTypes Set of unit types
			@return Unit ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		ClosestUnitMultipleTypes: function(aHand: Integer; X, Y: Integer; aUnitTypes: TByteSet): Integer;

		{
			Returns the unit of the specified player and unit types that is closest to the specified coordinates,
			or -1 if no such unit was found.
			The unit types is a "set of TKMUnitType", for example [utSerf, utMilitia]
			@since 13900
			@param aHand
			@param X, Y
			@param aUnitTypes Set of unit types
			@return Unit ID
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		ClosestUnitMultipleTypesEx: function(aHand: Integer; X, Y: Integer; aUnitTypes: TKMUnitTypeSet): Integer;

		{
			Check if two tiles are connected by walkable road
			@since 6602
			@param X1 left coordinate
			@param Y1 top coordinate
			@param X2 right coordinate
			@param Y2 bottom coordinate
			@return Connected
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		ConnectedByRoad: function(X1: Integer; Y1: Integer; X2: Integer; Y2: Integer): Boolean;

		{
			Check if two tiles are connected by a walkable route
			@since 6602
			@param X1 Left coordinate
			@param Y1 Top coordinate
			@param X2 Right coordinate
			@param Y2 Bottom coordinate
			@return Connected
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		ConnectedByWalking: function(X1: Integer; Y1: Integer; X2: Integer; Y2: Integer): Boolean;

		{
			Check if a tile is revealed in fog of war for a player
			@since 5097
			@param aHand
			@param aX, aY
			@return Revealed
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		FogRevealed: function(aHand: Byte; aX, aY: Integer): Boolean;

		{
			Get the game speed
			@since 11000
			@return Game speed
		}
		GameSpeed: function: Single;

		{
			Return True if game speed change is allowed
			@since 11000
			@return Is game speed change allowed
		}
		GameSpeedChangeAllowed: function: Boolean;

		{
			Get the number of game ticks since mission start
			@since 5057
			@return Ticks (~10 per second)
			@kind tickCount
		}
		GameTime: function: Cardinal;

		{
			Return if specified group is allowed to be selected and viewed by his allies
			@since 12600
			@param aGroupID
			@kind aGroupID groupId
		}
		GroupAllowAllyToSelect: function(aGroupID: Integer): Boolean;

		{
			Returns True if target Group is assigned to the Defence Position at coordinates X, Y
			if X = -1, or Y = -1, then those coordinates does not used to filter defence position
			@since 7000
			@param aGroupID
			@param X, Y
			@return Group assigned to Defence position
			@kind aGroupID groupId
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GroupAssignedToDefencePosition: function(aGroupID: Integer; X, Y: Integer): Boolean;

		{
			Returns the ID of the group of the unit on the specified tile or -1 if no group exists there
			@since 5057
			@param aX, aY
			@return Group ID
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind groupId
		}
		GroupAt: function(aX, aY: Integer): Integer;

		{
			Returns the number of columns (units per row) of the specified group
			@since 5272
			@param aGroupID
			@return Column count
			@kind aGroupID groupId
		}
		GroupColumnCount: function(aGroupID: Integer): Integer;

		{
			Returns True if the group is dead (all members dead or joined other groups)
			@since 5057
			@param aGroupID
			@return Dead
			@kind aGroupID groupId
		}
		GroupDead: function(aGroupID: Integer): Boolean;

		{
			Returns True if specified group is idle (has no orders/action)
			@since 6523
			@param aGroupID
			@return Idle
			@kind aGroupID groupId
		}
		GroupIdle: function(aGroupID: Integer): Boolean;

		{
			Returns True if specified group is in fight
			@since 7000
			@param aGroupID
			@param aCountCitizens including fights with citizens
			@return InFight
			@kind aGroupID groupId
		}
		GroupInFight: function(aGroupID: Integer; aCountCitizens: Boolean): Boolean;

		{
			Returns the manual formation parameter of the specified group (False for new group, True if player changed formation manually at least once)
			@since 11200
			@param aGroupID
			@return manual formation
			@kind aGroupID groupId
		}
		GroupManualFormation: function(aGroupID: Integer): Boolean;

		{
			Returns the unit ID of the specified group member.
			Member 0 will be the flag holder, 1...GroupMemberCount-1 will be the other members
			(0
			@since 5057
			@param aGroupID
			@param aMemberIndex
			@return Unit ID
			@kind aGroupID groupId
			@kind unitId
		}
		GroupMember: function(aGroupID: Integer; aMemberIndex: Integer): Integer;

		{
			Returns the total number of members of the specified group
			@since 5057
			@param aGroupID
			@return Member count
			@kind aGroupID groupId
		}
		GroupMemberCount: function(aGroupID: Integer): Integer;

		{
			Returns current order of the specified group
			@since 7000
			@param aGroupID
			@return TKMGroupOrder
			@kind aGroupID groupId
		}
		GroupOrder: function(aGroupID: Integer): TKMGroupOrder;

		{
			Returns the owner of the specified group or -1 if Group ID invalid
			@since 5057
			@param aGroupID
			@return Player ID
			@kind aGroupID groupId
			@kind handIndex
		}
		GroupOwner: function(aGroupID: Integer): Integer;

		{
			Returns the type of the specified group or -1 if Group ID invalid
			@since 5932
			@deprecated Use GroupTypeEx instead
			@param aGroupID
			@return Group type, values are 0 - melee, 1 - antiHorse, 2 - ranged, 3 - mounted
			@kind aGroupID groupId
			@kind groupTypeId
		}
		GroupType: function(aGroupID: Integer): Integer;

		{
			Returns the type of the specified group or gtNone if Group ID invalid
			@since 13900
			@param aGroupID
			@return Group type
			@kind aGroupID groupId
		}
		GroupTypeEx: function(aGroupID: Integer): TKMGroupType;

		{
			Return if specified house is allowed to be selected and viewed by his allies
			@since 10940
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseAllowAllyToSelect: function(aHouseID: Integer): Boolean;

		{
			Returns the ID of the house at the specified location or -1 if no house exists there
			@since 5057
			@param aX, aY
			@return House ID
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind houseId
		}
		HouseAt: function(aX, aY: Integer): Integer;

		{
			Returns X coordinate of Rally Point of specified barracks or 0 if BarracksID is invalid
			@since 6516
			@param aBarracks
			@return X coordinate
			@kind aBarracks houseId
			@kind xCoordinate
		}
		HouseBarracksRallyPointX: function(aBarracks: Integer): Integer;

		{
			Returns Y coordinate of Rally Point of specified barracks or 0 if BarracksID is invalid
			@since 6516
			@param aBarracks
			@return Y coordinate
			@kind aBarracks houseId
			@kind yCoordinate
		}
		HouseBarracksRallyPointY: function(aBarracks: Integer): Integer;

		{
			Returns if recruits are blocked in the specified Barracks
			@since 14000
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseBarracksRecruitBlock: function(aHouseID: Integer): Boolean;

		{
			Return number of recruits in the specified barracks or 0 if BarracksID is invalid
			@since 12600
			@param aBarracks
			@kind aBarracks houseId
		}
		HouseBarracksRecruitsCount: function(aBarracks: Integer): Integer;

		{
			Returns building progress of the specified house
			@since 6285
			@param aHouseID
			@return Building progress
			@kind aHouseID houseId
		}
		HouseBuildingProgress: function(aHouseID: Integer): Integer;

		{
			Returns True if the specified house can reach the resources that it mines (coal, stone, fish, etc.)
			@since 5993
			@param aHouseID
			@return Reachable
			@kind aHouseID houseId
		}
		HouseCanReachResources: function(aHouseID: Integer): Boolean;

		{
			Returns the damage of the specified house or -1 if House ID invalid
			@since 5057
			@param aHouseID
			@return House damage
			@kind aHouseID houseId
		}
		HouseDamage: function(aHouseID: Integer): Integer;

		{
			Returns True if the specified house has delivery disabled
			@since 5057
			@param aHouseID
			@return Blocked
			@kind aHouseID houseId
		}
		HouseDeliveryBlocked: function(aHouseID: Integer): Boolean;

		{
			Returns house delivery mode,
			if no house was found then ID = 1 is returned
			@since 13900
			@param aHouseID
			@return Delivery mode
			@kind aHouseID houseId
		}
		HouseDeliveryMode: function(aHouseID: Integer): TKMDeliveryMode;

		{
			Returns True if the house is destroyed
			@since 5057
			@param aHouseID
			@return Destroyed
			@kind aHouseID houseId
		}
		HouseDestroyed: function(aHouseID: Integer): Boolean;

		{
			Returns House Flag Point of specified house or KMPoint(0,0) if aHouseId is invalid
			@since 7000
			@param aHouseID
			@return Flag Point
			@kind aHouseID houseId
		}
		HouseFlagPoint: function(aHouseID: Integer): TKMPoint;

		{
			Returns an array with IDs for all the units in the specified house
			@since 12982
			@param aHouseID
			@return Array of unit IDs
			@kind aHouseID houseId
			@kind unitId
		}
		HouseGetAllUnitsIn: function(aHouseID: Integer): TIntegerArray;

		{
			❌`Deprecated`
			*Method could be removed in the future game versions, use HouseHasWorker instead*
			Returns True if the specified house currently has a worker
			@since 5057
			@param aHouseID
			@return Has worker
			@kind aHouseID houseId
		}
		HouseHasOccupant: function(aHouseID: Integer): Boolean;

		{
			Returns True if the specified house currently has a worker
			@since 13050
			@param aHouseID
			@return Has worker
			@kind aHouseID houseId
		}
		HouseHasWorker: function(aHouseID: Integer): Boolean;

		{
			Returns True if the specified house is closed for worker
			@since 15000
			@param aHouseID
			@kind aHouseID houseId
		}
		HouseIsClosedForWorker: function(aHouseID: Integer): Boolean;

		{
			Returns True if the specified house is fully built
			@since 5345
