{
	KaM Remake scripting API stubs - Utils (r16020).
	GENERATED by tools/generate_stubs.py from the wiki page Utils-(Mission-Script-Dynamic); do not edit,
	put corrections into tools/overrides/r16020/Utils.script instead.
}

type
	{
		TKMScriptUtils: type of the Utils object.
		@hidden
	}
	TKMScriptUtils = record
		{
			Returns absolute value of specified integer
			@since 7000
			@param aValue
		}
		AbsI: function(aValue: Integer): Integer;

		{
			Returns absolute value of specified single number
			@since 7000
			@param aValue
		}
		AbsS: function(aValue: Single): Single;

		{
			Checks how many times specified string comes in requested array
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayElementCount: function(aElement: AnsiString; aArray: array of String): Integer;

		{
			Checks how many times specified boolean comes in requested array
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayElementCountB: function(aElement: Boolean; aArray: array of Boolean): Integer;

		{
			Checks how many times specified integer comes in requested array
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayElementCountI: function(aElement: Integer; aArray: array of Integer): Integer;

		{
			Checks how many times specified single comes in requested array
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayElementCountS: function(aElement: Single; aArray: array of Single): Integer;

		{
			Checks whether requested array has specified string
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayHasElement: function(aElement: AnsiString; aArray: array of String): Boolean;

		{
			Checks whether requested array has specified boolean
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayHasElementB: function(aElement: Boolean; aArray: array of Boolean): Boolean;

		{
			Checks whether requested array has specified integer
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayHasElementI: function(aElement: Integer; aArray: array of Integer): Boolean;

		{
			Checks whether requested array has specified single number
			@since 7000
			@param aElement
			@param aArray
		}
		ArrayHasElementS: function(aElement: Single; aArray: array of Single): Boolean;

		{
			Removes element on specified index in specified array of integer.
			Integer array should be declared as TIntegerArray instead of array of integer.
			@since 7000
			@param aIndex
			@param aArray
		}
		ArrayRemoveIndexI: function(aIndex: Integer; aArray: TIntegerArray): TIntegerArray;

		{
			Removes element on specified index in specified array of string.
			String array should be declared as TAnsiStringArray instead of array of AnsiString.
			@since 7000
			@param aIndex
			@param aArray
		}
		ArrayRemoveIndexS: function(aIndex: Integer; aArray: TAnsiStringArray): TAnsiStringArray;

		{
			Return string representation of Boolean value: 'True' or 'False'
			@since 7000
			@param aBool
		}
		BoolToStr: function(aBool: Boolean): AnsiString;

		{
			Rounds specified single number aValue to nearest multiple of specified base aBase. Rounding up.
			F.e. CeilTo(11.7, 5) = 15 while CeilTo(-11.7, 5) = -10
			@since 7000
			@param aValue
			@param aBase
		}
		CeilTo: function(aValue: Single; aBase: Integer): Integer;

		{
			Get Color Brightness from HEX BGR color
			@since 10940
			@param aHexColor
			@return Color Brightness OR -1 if aHexColor not equal to HEX BGR
		}
		ColorBrightness: function(aHexColor: string): Single;

		{
			Compares Str1 to Str2, with case-sensitivity.
			@since 11750
			@param Str1
			@param Str2
			@return The return value is less than 0 if Str1 is less than Str2, 0 if Str1 equals Str2, or greater than 0 if Str1 is greater than Str2.
		}
		CompareString: function(Str1: string; Str2: string): Integer;

		{
			Compares Str1 to Str2, without case-sensitivity.
			@since 11750
			@param Str1
			@param Str2
			@return The return value is less than 0 if Str1 is less than Str2, 0 if Str1 equals Str2, or greater than 0 if Str1 is greater than Str2.
		}
		CompareText: function(Str1: string; Str2: string): Integer;

		{
			Creates a copy of part of a string
			The first character of a string has index = 1.
			Up to Count characters are copied from the Index of the Str string to the returned string.
			Less than Count characters will be copied, if the end of the Str string is encountered before Count characters.
			@since 11750
			@param Str
			@param Index
			@param Count
			@return Copy of part of a Str string
		}
		CopyString: function(Str: string; Index: Integer; Count: Integer): String;

		{
			Deletes up to Count characters from the Str string starting from position Index
			The first character of a string has index = 1.
			If the Index is before the first, or after the last character of Str, then no characters are deleted
			No error is produced if Count exceeds the remaining character count of Str.
			@since 11750
			@param Str
			@param Index
			@param Count
		}
		DeleteString: procedure(var Str: string; Index: Integer; Count: Integer);

		{
			Returns the closest to aValue integer that is in interval [aMin..aMax]
			@since 7000
			@param aValue
			@param aMin, aMax
		}
		EnsureRangeI: function(aValue: Integer; aMin, aMax: Integer): Integer;

		{
			Returns the closest to aValue single number that is in interval [aMin..aMax]
			@since 7000
			@param aValue
			@param aMin, aMax
		}
		EnsureRangeS: function(aValue: Single; aMin, aMax: Single): Single;

		{
			Rounds specified single number aValue to nearest multiple of specified base aBase. Rounding down.
			F.e. FloorTo(11.7, 5) = 10 while FloorTo(-11.7, 5) = -15
			@since 7000
			@param aValue
			@param aBase
		}
		FloorTo: function(aValue: Single; aBase: Integer): Integer;

		{
			Wrapper for pascal Format function
			Formats aFormatting string with specified aData array of parameters
			@since 7000
			@param aFormatting
			@param aData
		}
		Format: function(aFormatting: string; aData: array of const): string;

		{
			Wrapper for pascal FormatFloat function
			Formats aValue with specified aFormat
			@since 11000
			@param aFormat
			@param aValue
		}
		FormatFloat: function(aFormat: string; aValue: Single): string;

		{
			Checks condition aBool and returns aTrue/aFalse string depending on check result
			@since 7000
			@param aBool
			@param aTrue
			@param aFalse
		}
		IfThen: function(aBool: Boolean; aTrue: AnsiString; aFalse: AnsiString): AnsiString;

		{
			Checks condition aBool and returns aTrue/aFalse integer depending on check result
			@since 7000
			@param aBool
			@param aTrue
			@param aFalse
		}
		IfThenI: function(aBool: Boolean; aTrue: Integer; aFalse: Integer): Integer;

		{
			Checks condition aBool and returns aTrue/aFalse single number depending on check result
			@since 7000
			@param aBool
			@param aTrue
			@param aFalse
		}
		IfThenS: function(aBool: Boolean; aTrue: Single; aFalse: Single): Single;

		{
			2D variant of InRange, can be used for unit locs checks
			@since 7000
			@param aX, aY
			@param aXMin
			@param aYMin
			@param aXMax
			@param aYMax
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind aXMin xCoordinate
			@kind aYMin yCoordinate
			@kind aXMax xCoordinate
			@kind aYMax yCoordinate
		}
		InAreaI: function(aX, aY: Integer; aXMin: Integer; aYMin: Integer; aXMax: Integer; aYMax: Integer): Boolean;

		{
			2D variant of InRange
			@since 7000
			@param aX, aY
			@param aXMin
			@param aYMin
			@param aXMax
			@param aYMax
		}
		InAreaS: function(aX, aY: Single; aXMin: Single; aYMin: Single; aXMax: Single; aYMax: Single): Boolean;

		{
			Checks whether specified aValue is in interval [aMin..aMax]
			@since 7000
			@param aValue
			@param aMin, aMax
		}
		InRangeI: function(aValue: Integer; aMin, aMax: Integer): Boolean;

		{
			Checks whether specified aValue is in interval [aMin..aMax]
			@since 7000
			@param aValue
			@param aMin, aMax
		}
		InRangeS: function(aValue: Single; aMin, aMax: Single): Boolean;

		{
			Inserts one string, Source into another string, Target at the given position Index.
			The first character of a string has index = 1.
			The Target string characters from the Index character are moved right to make way for the Source string.
			The length of Target string is now the sum of the length of the two strings.
			To insert into the start of Target, set Index to 1 or less.
			To append to the end of Target, set Index after the last character of Target.
			@since 11750
			@param Source
			@param Target
			@param Index
		}
		InsertString: procedure(Source: string; var Target: string; Index: Integer);

		{
			Returns point record with specified coordinates
			@since 7000
			@param X, Y
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		KMPoint: function(X, Y: Integer): TKMPoint;

		{
			Returns the natural logarithm of X
			@since 15000
			@param X
		}
		Ln: function(X: Extended): Extended;

		{
			Returns log of X for a base of 10
			@since 15000
			@param X
		}
		Log10: function(X: Extended): Extended;

		{
			Returns log of X for a base of 2
			@since 15000
			@param X
		}
		Log2: function(X: Extended): Extended;

		{
			Returns log of X for a specified base
			@since 15000
			@param Base
			@param X
		}
		LogN: function(Base: Extended; X: Extended): Extended;

		{
			Changes upper case characters in a string Str to lower case
			@since 11750
			@param Str
		}
		LowerCase: function(Str: string): String;

		{
			Returns max number of two specified
			@since 7000
			@param A, B
		}
		MaxI: function(A, B: Integer): Integer;

		{
			Returns max number of array elements
			@since 7000
			@param aArray
		}
		MaxInArrayI: function(aArray: array of Integer): Integer;

		{
			Returns max number of array elements
			@since 7000
			@param aArray
		}
		MaxInArrayS: function(aArray: array of Single): Single;

		{
			Returns max number of two specified
			@since 7000
			@param A, B
		}
		MaxS: function(A, B: Single): Single;

		{
			Returns min number of two specified
			@since 7000
			@param A, B
		}
		MinI: function(A, B: Integer): Integer;

		{
			Returns min number of array elements
			@since 7000
			@param aArray
		}
		MinInArrayI: function(aArray: array of Integer): Integer;

		{
			Returns min number of array elements
			@since 7000
			@param aArray
		}
		MinInArrayS: function(aArray: array of Single): Single;

		{
			Returns min number of two specified
			@since 7000
			@param A, B
		}
		MinS: function(A, B: Single): Single;

		{
			Copy data from a Source to a Destination
			Count characters are copied from storage referenced by Source and written to Destination
			It can be used to take a copy of a substring from one string and overlay it on top of part of another string.
			@since 11750
			@param Source
			@param Destination
			@param Count
		}
		MoveString: procedure(Source: string; var Destination: string; Count: Integer);

		{
			Searches for a substring, SubStr, in a string, Str.
			Returns an integer value that is the index of the first character of SubStr within Str.
			Function is case-sensitive.
			If SubStr is not found, Result = 0
			@since 11750
			@param SubStr
			@param Str
		}
		Pos: function(SubStr: string; Str: string): Integer;

		{
			Exponentation, base 'Base' raised to power 'Exp'.
			F.e. Power(3, 2) = 3^2 = 9
			Returns base "Base" raised to power "Exp"
			@since 7000
			@param aBase
			@param aExp
		}
		Power: function(aBase: Extended; aExp: Extended): Extended;

		{
			Generates a random number in requested range aFrom..aTo (inclusive)
			@since 11000
			@param aFrom
			@param aTo
		}
		RandomRangeI: function(aFrom: Integer; aTo: Integer): Integer;

		{
			Converts RGB to HEX BGR color
			Example
			VAR := RGBDecToBGRHex(255, 255, 0);
			The result of the VAR will be 00FFFF
			@since 10940
			@param aR
			@param aG
			@param aB
			@return HEX BGR Color
		}
		RGBDecToBGRHex: function(aR: Byte; aG: Byte; aB: Byte): AnsiString;

		{
			Converts HEX RGB to HEX BGR color
			Example
			VAR := RGBToBGRHex('#FFFF00');
			The result of the VAR will be 00FFFF
			@since 10940
			@param aHexColor
			@return HEX BGR Color or '' if aHexColor not equal to HEX RGB
		}
		RGBToBGRHex: function(aHexColor: string): AnsiString;

		{
			Rounds specified single number aValue to nearest multiple of specified base aBase. Rounding to the nearest integer.
			If the number is exactly midway between two integers, then it rounds towards the even one (multiplied on aBase).
			F.e. RoundTo(11.7, 5) = 10 while RoundTo(-11.7, 5) = -10
			RoundTo(12.5, 5) = 10 while RoundTo(17.5, 5) = 20
			@since 12400
			@param aValue
			@param aBase
		}
		RoundTo: function(aValue: Single; aBase: Integer): Integer;

		{
			Returns A^2 = A*A
			@since 7000
			@param A
		}
		Sqr: function(A: Extended): Extended;

		{
			Replaces the first or all occurences of a substring OldPattern in Str string with NewPattern according to additional settings
			The changed string is returned as Result
			The settings may be none, one, or both of these values:
			@since 11750
			@param Str
			@param OldPattern
			@param NewPattern
			@param aReplaceAll Change all occurrences
			@param aIgnoreCase Ignore case when searching
		}
		StringReplace: function(Str: string; OldPattern: string; NewPattern: string; aReplaceAll: Boolean; aIgnoreCase: Boolean): String;

		{
			Returns sum of the elements of requested array
			@since 7000
			@param aArray
		}
		SumI: function(aArray: array of Integer): Integer;

		{
			Returns sum of the elements of requested array
			@since 7000
			@param aArray
		}
		SumS: function(aArray: array of Single): Single;

		{
			Converts game ticks count into string: HH:MM:SS
			Can be used for scripted timers
			@since 7000
			@param aTicks
			@kind aTicks tickCount
		}
		TimeToString: function(aTicks: Integer): AnsiString;

		{
			Converts Time in game ticks
			@since 10940
			@param aHours
			@param aMinutes
			@param aSeconds
			@return game ticks
			@kind tickCount
		}
		TimeToTick: function(aHours: Integer; aMinutes: Integer; aSeconds: Integer): Cardinal;

		{
			Removes blank and control characters (such as line feed) from the start and end of a string.
			@since 11750
			@param Str
		}
		Trim: function(Str: string): String;

		{
			Removes blank and control characters (such as line feed) from the start of a string.
			@since 11750
			@param Str
		}
		TrimLeft: function(Str: string): String;

		{
			Removes blank and control characters (such as line feed) from the end of a string.
			@since 11750
			@param Str
		}
		TrimRight: function(Str: string): String;

		{
			Rounds specified single number aValue to nearest multiple of specified base aBase. Rounding to zero.
			F.e. TruncTo(11.7, 5) = 10 while TruncTo(-11.7, 5) = -10
			@since 12400
			@param aValue
			@param aBase
		}
		TruncTo: function(aValue: Single; aBase: Integer): Integer;

		{
			Changes lower case characters in a string Str to upper case
			@since 11750
			@param Str
		}
		UpperCase: function(Str: string): String;

	end;

var
	{
		The Utils object: helper functions.
	}
	Utils: TKMScriptUtils;
	{
		Short alias of Utils.
	}
	U: TKMScriptUtils;
