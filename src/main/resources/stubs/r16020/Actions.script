		{
			Apply brush from MapEd to the map
			@since 11000
			@param X X coodinate
			@param Y Y coodinate
			@param aSquare is brush square or circle
			@param aSize brush size
			@param aTerKind terrain kind
			@param aRandomTiles use random tiles
			@param aOverrideCustomTiles override tiles, that were manually set from tiles table
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapBrush: procedure(X: Integer; Y: Integer; aSquare: Boolean; aSize: Integer; aTerKind: TKMTerrainKind; aRandomTiles: Boolean; aOverrideCustomTiles: Boolean);

		{
			Apply Elevation change brush from MapEd to the map
			@since 11000
			@param X X coodinate
			@param Y Y coodinate
			@param aSquare is brush square or circle
			@param aRaise raise elevation or lower it
			@param aSize brush size
			@param aSlope elevation slope
			@param aSpeed elevation change speed
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapBrushElevation: procedure(X: Integer; Y: Integer; aSquare: Boolean; aRaise: Boolean; aSize: Integer; aSlope: Integer; aSpeed: Integer);

		{
			Apply Equalize brush from MapEd to the map
			@since 11000
			@param X X coodinate
			@param Y Y coodinate
			@param aSquare is brush square or circle
			@param aSize brush size
			@param aSlope elevation slope
			@param aSpeed elevation change speed
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapBrushEqualize: procedure(X: Integer; Y: Integer; aSquare: Boolean; aSize: Integer; aSlope: Integer; aSpeed: Integer);

		{
			Apply Flatten brush from MapEd to the map
			@since 11000
			@param X X coodinate
			@param Y Y coodinate
			@param aSquare is brush square or circle
			@param aSize brush size
			@param aSlope elevation slope
			@param aSpeed elevation change speed
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapBrushFlatten: procedure(X: Integer; Y: Integer; aSquare: Boolean; aSize: Integer; aSlope: Integer; aSpeed: Integer);

		{
			Apply magic water brush from MapEd to the map
			@since 11000
			@param X X coodinate
			@param Y Y coodinate
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapBrushMagicWater: procedure(X: Integer; Y: Integer);

		{
			Apply brush with mask specified from MapEd to the map
			@since 11000
			@param X X coodinate
			@param Y Y coodinate
			@param aSquare is brush square or circle
			@param aSize brush size
			@param aTerKind terrain kind
			@param aRandomTiles use random tiles
			@param aOverrideCustomTiles override tiles, that were manually set from tiles table
			@param aBrushMask brush mask type
			@param aBlendingLvl blending level for masks. Allowed values are from 0 to 15
			@param aUseMagicBrush enable/disable magic brush to change/remove brush mask from the area
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapBrushWithMask: procedure(X: Integer; Y: Integer; aSquare: Boolean; aSize: Integer; aTerKind: TKMTerrainKind; aRandomTiles: Boolean; aOverrideCustomTiles: Boolean; aBrushMask: TKMTileMaskKind; aBlendingLvl: Integer; aUseMagicBrush: Boolean);

		{
			Copies map tiles area. This function can be called only in OnMissionStart procedure.
			aFromTileX, aFromTileY - top left tile coordinate of rectangle that should be copied
			aWidth, aHeight - size of rectangle that should be copied
			aToTileX, aToTileY - coordinates of tile where copied rectangle should be pasted.
			Minimum valid size of copy rectangle is 1x1.
			@since 15925
			@param aFromTileX
			@param aFromTileY
			@param aWidth
			@param aHeight
			@param aToTileX
			@param aToTileY
			@kind aFromTileX xCoordinate
			@kind aFromTileY yCoordinate
			@kind aToTileX xCoordinate
			@kind aToTileY yCoordinate
		}
		MapCopyRect: procedure(aFromTileX: Integer; aFromTileY: Integer; aWidth: Integer; aHeight: Integer; aToTileX: Integer; aToTileY: Integer);

		{
			Flips map horizontally or vertically within selected rectangle.
			aLeft, aTop - coordinates of the top left tile of rectangle that should be flipped
			aRight, aBottom - coordinates of the bottom right tile of rectangle that should be flipped
			Minimum valid size of flip rectangle is 1x1.
			@since 15806
			@param aLeft
			@param aTop
			@param aRight
			@param aBottom
			@param aAxis
			@kind aLeft xCoordinate
			@kind aTop yCoordinate
			@kind aRight xCoordinate
			@kind aBottom yCoordinate
		}
		MapFlip: procedure(aLeft: Integer; aTop: Integer; aRight: Integer; aBottom: Integer; aAxis: TKMFlipAxis);

		{
			Sets the height of the terrain at the top left corner (vertex) of the tile at the specified XY coordinates.
			Returns True if the change succeeded or False if it failed.
			The change will fail if it would cause a unit to become stuck or a house to be damaged
			@since 6587
			@param X, Y
			@param Height Height (0..100)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileHeightSet: function(X, Y: Integer; Height: Integer): Boolean;

		{
			Sets the terrain object on the tile at the specified XY coordinates.
			Object IDs can be seen in the map editor on the objects tab.
			Object 61 is "block walking". To set no object, use object type 255.
			Returns True if the change succeeded or False if it failed.
			The change will fail if it would cause a unit to become stuck or a house/field to be damaged
			@since 6587
			@param X, Y
			@param Obj Object type (0..255)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileObjectSet: function(X, Y: Integer; Obj: Integer): Boolean;

		{
			Sets the terrain overlay on the tile at the specified XY coordinates.
			aOverwrite: True allows to destroy roads and re-dig fields (like in game we can build road on top of field and when laborer dies there is a digged overlay left)
			@since 11000
			@param X, Y
			@param aOverlay
			@param aOverwrite False means safe way to change tile overlay, disallowing to set it on top of old fields/roads
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileOverlaySet: function(X, Y: Integer; aOverlay: TKMTileOverlay; aOverwrite: Boolean): Boolean;

		{
			Sets array of tiles info, with possible change of
			1. terrain (tile type) and/or rotation (same as for MapTileSet),
			2. tile height (same as for MapTileHeightSet)
			3. tile object (same as for MapTileObjectSet)
			Works much faster, then applying all changes successively for every tile, because pathfinding compute is executed only once after all changes have been done
			TKMTerrainTileBrief = record
			X, Y: Word;     // Tile map coordinates
			Terrain: Word;  // Terrain tile type (0..596)
			Rotation: Byte; // Tile rotation (0..3)
			Height: Byte;   // Heigth (0..150)
			Obj: Word;      // Object (0..255)
			UpdateTerrain, UpdateRotation, UpdateHeight, UpdateObject: Boolean; // What part of tile should be updated?
			end;
			UpdateXXX fields determines what should be changed on tile
			F.e. if we want to change terrain type and height, then UpdateTerrain and UpdateHeight should be set to True
			Note: aTiles elements should start from 0, as for dynamic array. So f.e. to change map tile 1,1 we should set aTiles[0][0].
			Note: Errors are shown as map tiles (f.e. for error while applying aTiles[0][0] tile there will be a message with for map tile 1,1)
			/*
			@since 7000
			@param aTiles Check detailed info on this type in description
			@param aRevertOnFail do we need to revert all changes on any error while applying changes. If True, then no changes will be applied on error. If False - we will continue apply changes where possible
			@param aShowDetailedErrors show detailed errors after. Can slow down the execution, because of logging. If aRevertOnFail is set to True, then only first error will be shown
			@return True, if there was no errors on any tile. False if there was at least 1 error.
		}
		MapTilesArraySet: function(aTiles: array of TKMTerrainTileBrief; aRevertOnFail: Boolean; aShowDetailedErrors: Boolean): Boolean;

		{
			Sets array of tiles info, like MapTilesArraySetS, but tile string array is
			stored in file.
			This function is useful if you need to create dynamic map from scratch.
			File Array must be in following format: X,Y,Terrain,Rotation,Height,Obj;X,Y,Terrain,Rotation,Height,Obj;...
			f.e. 1,1,20,2,87,12;1,2,20,2,12;...
			In case of invalid structure detection / failed variable parsing you can find
			detailed errors in LOG file.
			If you need to skip terrain or rotation/height/obj use -1 as parameter
			f.e.
			Skipping rotation for tile [7,2]: 7,2,20,-1,87,12
			Skipping obj for tile [7,2]: 7,2,20,2,87,-1
			Skipping height for tile [7,2]: 7,2,20,2,-1,5 etc.
			xOffset - offset that would be added to tiles X coordinates.
			yOffset - offset that would be added to tiles Y coordinates.
			@since 15000
			@param aFileName
			@param aOffsetX
			@param aOffsetY
			@param aRevertOnFail
			@param aShowDetailedErrors
		}
		MapTilesArraySetF: function(aFileName: string; aOffsetX: Integer; aOffsetY: Integer; aRevertOnFail: Boolean; aShowDetailedErrors: Boolean): Boolean;

		{
			Sets array of tiles info, like MapTilesArraySet, but parameters are
			passed as an TAnsiStringArray instead of array of TKMTerrainTileBrief.
			This function is useful if you need to create dynamic map from scratch.
			Array must contain strings in following format: 'X,Y,Terrain,Rotation,Height,Obj'
			f.e. '1,1,20,2,87,12'
			In case of invalid structure detection / failed variable parsing you can find
			detailed errors in LOG file.
			If you need to skip terrain or rotation/height/obj use -1 as parameter
			f.e.
			Skipping rotation for tile [7,2]: '7,2,20,-1,87,12'
			Skipping obj for tile [7,2]: '7,2,20,2,87,-1'
			Skipping height for tile [7,2]: '7,2,20,2,-1,5' etc.
			@since 7000
			@param aTilesS
			@param aRevertOnFail
			@param aShowDetailedErrors
		}
		MapTilesArraySetS: function(aTilesS: TAnsiStringArray; aRevertOnFail: Boolean; aShowDetailedErrors: Boolean): Boolean;

		{
			Sets the tile type and rotation at the specified XY coordinates.
			Tile IDs can be seen by hovering over the tiles on the terrain tiles tab in the map editor.
			Returns True if the change succeeded or False if it failed.
			The change will fail if it would cause a unit to become stuck or a house/field to be damaged
			@since 6587
			@param X, Y
			@param aType Tile type (0..255)
			@param aRotation Tile rotation (0..3)
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		MapTileSet: function(X, Y: Integer; aType: Integer; aRotation: Integer): Boolean;

		{
			Sets the trade in the specified market
			@since 6216
			@deprecated Use MarketSetTradeEx instead
			@param aMarketID
			@param aFrom
			@param aTo
			@param aAmount
			@kind aMarketID houseId
			@kind aFrom wareTypeId
			@kind aTo wareTypeId
		}
		MarketSetTrade: procedure(aMarketID: Integer; aFrom: Integer; aTo: Integer; aAmount: Integer);

		{
			Sets the trade in the specified market
			@since 14000
			@param aMarketID
			@param aFrom
			@param aTo
			@param aAmount
			@kind aMarketID houseId
		}
		MarketSetTradeEx: procedure(aMarketID: Integer; aFrom: TKMWareType; aTo: TKMWareType; aAmount: Integer);

		{
			Appends to text overlaid on top left of screen.
			If the player index is -1 it will be appended for all players.
			@since 5333
			@param aHand
			@param aText
			@kind aHand handIndex
		}
		OverlayTextAppend: procedure(aHand: ShortInt; aText: AnsiString);

		{
			Appends to text overlaid on top left of screen with formatted arguments (same as Format function).
			If the player index is -1 it will be appended for all players.
			Params: Array of arguments
			@since 5333
			@param aHand
			@param aText
			@param aParams
			@kind aHand handIndex
		}
		OverlayTextAppendFormatted: procedure(aHand: ShortInt; aText: AnsiString; aParams: array of const);

		{
			Sets text overlaid on top left of screen.
			If the player index is -1 it will be set for all players.
			@since 5333
			@param aHand
			@param aText
			@kind aHand handIndex
		}
		OverlayTextSet: procedure(aHand: ShortInt; aText: AnsiString);

		{
			Sets text overlay font
			Possible values are: fntAntiqua, fntGame, fntGrey, fntMetal, fntMini, fntOutline, fntArial, fntMonospaced
			If the player index is -1 it will be set for all players.
			@since 14000
			@param aHand
			@param aFont
			@kind aHand handIndex
		}
		OverlayTextSetFont: procedure(aHand: ShortInt; aFont: TKMFont);

		{
			Sets text overlaid on top left of screen with formatted arguments (same as Format function).
			If the player index is -1 it will be set for all players.
			Params: Array of arguments
			@since 5333
			@param aHand
			@param aText
			@param aParams
			@kind aHand handIndex
		}
		OverlayTextSetFormatted: procedure(aHand: ShortInt; aText: AnsiString; aParams: array of const);

		{
			Sets or unsets text overlay word wrap
			If the player index is -1 it will be set for all players.
			@since 14000
			@param aHand
			@param aWordWrap
			@kind aHand handIndex
		}
		OverlayTextSetWordWrap: procedure(aHand: ShortInt; aWordWrap: Boolean);

		{
			Sets game peacetime. Peacetime will be set to the value of aPeacetime div 600
			@since 11000
			@param aPeacetime game time in ticks
			@kind aPeacetime tickCount
		}
		Peacetime: procedure(aPeacetime: Cardinal);

		{
			Adds a corn field plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile blocked)
			@since 5057
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddField: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Adds a house plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile is blocked)
			@since 5057
			@deprecated Use PlanAddHouseEx instead
			@param aHand
			@param aHouseType
			@param X, Y
			@kind aHand handIndex
			@kind aHouseType houseTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddHouse: function(aHand: Integer; aHouseType: Integer; X, Y: Integer): Boolean;

		{
			Adds a house plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile is blocked)
			@since 14000
			@param aHand
			@param aHouseType
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddHouseEx: function(aHand: Integer; aHouseType: TKMHouseType; X, Y: Integer): Boolean;

		{
			Adds a road plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile blocked)
			@since 5057
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddRoad: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Adds a wine field plan.
			Returns True if the plan was successfully added or False if it failed (e.g. tile blocked)
			@since 5057
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanAddWinefield: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Connects road plans between two points like AI builder and returns True if road plan was successfully added.
			If CompletedRoad = True, road will be added instead of plans
			@since 6303
			@param aHand
			@param X1 Left coordinate
			@param Y1 Top coordinate
			@param X2 Right coordinate
			@param Y2 Bottom coordinate
			@param aCompleted Completed road
			@kind aHand handIndex
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		PlanConnectRoad: function(aHand: Integer; X1: Integer; Y1: Integer; X2: Integer; Y2: Integer; aCompleted: Boolean): Boolean;

		{
			Removes house, road or field plans from the specified tile for the specified player
			Returns True if the plan was successfully removed or False if it failed (e.g. tile blocked)
			@since 5345
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		PlanRemove: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Add default goals/lost goals for the specified player.
			If the parameter buildings is True the goals will be important buildings.
			Otherwise it will be troops.
			@since 5165
			@param aHand
			@param aBuildings
			@kind aHand handIndex
		}
		PlayerAddDefaultGoals: procedure(aHand: Byte; aBuildings: Boolean);

		{
			Change whether player1 is allied to player2.
			If Compliment is True, then it is set both ways (so also whether player2 is allied to player1)
			@since 5097
			@param aHand1
			@param aHand2
			@param aCompliment Both ways
			@param aAllied
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerAllianceChange: procedure(aHand1: Byte; aHand2: Byte; aCompliment: Boolean; aAllied: Boolean);

		{
			Change whether player1 is allied to player2.
			If Compliment is True, then it is set both ways (so also whether player2 is allied to player1)
			@since 7000
			@param aHand1
			@param aHand2
			@param aCompliment Both ways
			@param aAllied
			@param aSyncAllyFog Synchronize allies fogs of war
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerAllianceNFogChange: procedure(aHand1: Byte; aHand2: Byte; aCompliment: Boolean; aAllied: Boolean; aSyncAllyFog: Boolean);

		{
			Sets player center screen at new coordinates.
			@since 15783
			@param aHand
			@param aX, aY
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayerCenterScreenSet: procedure(aHand: Integer; aX, aY: Integer);

		{
			Proclaims player defeated
			@since 5057
			@param aHand
			@kind aHand handIndex
		}
		PlayerDefeat: procedure(aHand: Integer);

		{
			Remove all player goals
			@since 11000
			@param aHand PlayerID
			@param aForAllPlayers also remove other player goals, related to this player
			@kind aHand handIndex
		}
		PlayerGoalsRemoveAll: procedure(aHand: Integer; aForAllPlayers: Boolean);

		{
			Sets player house lock aLock for a specified house type aHouseType
			if htAny is passed for house type then aLock will be applied to all house types
			@since 14600
			@param aHand
			@param aHouseType
			@param aLock
			@kind aHand handIndex
		}
		PlayerHouseTypeLock: procedure(aHand: Integer; aHouseType: TKMHouseType; aLock: TKMHandHouseLock);

		{
			Sets whether player A shares his beacons with player B.
			Sharing can still only happen between allied players, but this command lets you disable allies from sharing.
			@since 7000
			@param aHand1
			@param aHand2
			@param aBothWays share in both ways
			@param aShare
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerShareBeacons: procedure(aHand1: Integer; aHand2: Integer; aBothWays: Boolean; aShare: Boolean);

		{
			Sets whether player A shares his vision with player B (one way, for both ways use PlayerShareFogCompliment).
			Sharing can still only happen between allied players, but this command lets you disable allies from sharing.
			@since 5345
			@param aHand1
			@param aHand2
			@param aShare
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerShareFog: procedure(aHand1: Integer; aHand2: Integer; aShare: Boolean);

		{
			Sets whether players A and B share their vision (both ways).
			Sharing can still only happen between allied players, but this command lets you disable allies from sharing.
			@since 7000
			@param aHand1
			@param aHand2
			@param aShare
			@kind aHand1 handIndex
			@kind aHand2 handIndex
		}
		PlayerShareFogCompliment: procedure(aHand1: Integer; aHand2: Integer; aShare: Boolean);

		{
			Sets whether the player is allowed to trade the specified resource.
			if aHand = -1, then apply it to all players
			@since 14600
			@param aHand
			@param aWareType
			@param aAllowed
			@kind aHand handIndex
		}
		PlayerTradeAllowed: procedure(aHand: Integer; aWareType: TKMWareType; aAllowed: Boolean);

		{
			Sets whether the specified player can train / equip the specified unit type
			if aHand = -1, then apply it to all players
			@since 14600
			@param aHand
			@param aUnitType
			@param aCanTrain
			@kind aHand handIndex
		}
		PlayerUnitTypeCanTrain: procedure(aHand: Integer; aUnitType: TKMUnitType; aCanTrain: Boolean);

		{
			Sets ware distribution for the specified resource, house and player.
			Note: distribution should be set after 1st tick of the game,
			thus it will not make effect to use it in OnMissionStart event handler
			@since 5345
			@deprecated Use PlayerWareDistributionEx instead
			@param aHand
			@param aWareType
			@param aHouseType
			@param aAmount Distribution amount (0..5)
			@kind aHand handIndex
			@kind aWareType wareTypeId
			@kind aHouseType houseTypeId
		}
		PlayerWareDistribution: procedure(aHand: Byte; aWareType: Byte; aHouseType: Byte; aAmount: Byte);

		{
			Sets ware distribution for the specified resource, house and player.
			Note: distribution should be set after 1st tick of the game,
			thus it will not make effect to use it in OnMissionStart event handler
			@since 14600
			@param aHand
			@param aWareType
			@param aHouseType
			@param aAmount Distribution amount (0..5)
			@kind aHand handIndex
		}
		PlayerWareDistributionEx: procedure(aHand: Integer; aWareType: TKMWareType; aHouseType: TKMHouseType; aAmount: Integer);

		{
			Set specified player(s) victorious, and all team members of those player(s) if the 2nd parameter TeamVictory is set to True.
			All players who were not set to victorious are set to defeated.
			@since 5057
			@param aVictors Array of player IDs
			@param aTeamVictory
		}
		PlayerWin: procedure(aVictors: array of Integer; aTeamVictory: Boolean);

		{
			Plays OGG audio file.
			If the player index is -1 the sound will be played to all players.
			Mono and stereo OGG files are supported.
			OGG file goes in mission folder named: Mission Name.filename.ogg
			@since 7000
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayOGG: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays OGG audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			Radius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use radius 32).
			Only mono OGG files are supported.
			OGG file goes in mission folder named: Mission Name.filename.ogg.
			Will not play if the location is not revealed to the player.
			Higher volume range is allowed than PlayOGG as positional sounds are quieter
			@since 7000
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 4.0)
			@param aRadius Radius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayOGGAtLocation: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single; aRadius: Single; aX, aY: Integer): Integer;

		{
			Plays looped audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			aRadius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use aRadius 32).
			Only mono OGG files are supported.
			OGG file goes in mission folder named: Mission Name.filename.ogg.
			Will not play if the location is not revealed to the player (will start playing automatically when it is revealed).
			Higher aVolume range is allowed than PlayOGG as positional sounds are quieter.
			The sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 7000
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 4.0)
			@param aRadius aRadius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayOGGAtLocationLooped: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single; aRadius: Single; aX, aY: Integer): Integer;

		{
			Same as PlayOGG except music will fade then mute while the OGG is playing, then fade back in afterwards.
			You should leave a small gap at the start of your OGG file to give the music time to fade
			@since 7000
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayOGGFadeMusic: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays looped OGG audio file.
			If the player index is -1 the sound will be played to all players.
			Mono or stereo OGG files are supported.
			OGG file goes in mission folder named: Mission Name.filename.ogg.
			The sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 7000
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayOGGLooped: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays audio file.
			If the player index is -1 the sound will be played to all players.
			Possible to specify Looped or FadeMusic parameter
			Mono and stereo WAV and OGG files are supported.
			To specify audio format use afWav or afOgg
			WAV file goes in mission folder named: Mission Name.filename.wav.
			OGG file goes in mission folder named: Mission Name.filename.ogg
			If MusicFaded then sound will fade then mute while the file is playing, then fade back in afterwards.
			If looped, the sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 7000
			@param aHand
			@param aFileName
			@param aAudioFormat afWav or afOgg
			@param aVolume Audio level (0.0 to 1.0)
			@param aFadeMusic
			@param aLooped
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlaySound: function(aHand: ShortInt; aFileName: AnsiString; aAudioFormat: TKMAudioFormat; aVolume: Single; aFadeMusic: Boolean; aLooped: Boolean): Integer;

		{
			Plays audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			Possible to specify Looped or FadeMusic parameter
			aRadius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use aRadius 32).
			Only mono WAV or OGG files are supported.
			To specify audio format use afWav or afOgg
			WAV file goes in mission folder named: Mission Name.filename.wav.
			OGG file goes in mission folder named: Mission Name.filename.ogg.
			Will not play if the location is not revealed to the player (will start playing automatically when it is revealed).
			Higher aVolume range is allowed than PlaySound as positional sounds are quieter.
			If looped, the sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 7000
			@param aHand
			@param aFileName
			@param aAudioFormat afWav or afOgg
			@param aVolume Audio level (0.0 to 4.0)
			@param aFadeMusic
			@param aLooped
			@param aRadius aRadius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlaySoundAtLocation: function(aHand: ShortInt; aFileName: AnsiString; aAudioFormat: TKMAudioFormat; aVolume: Single; aFadeMusic: Boolean; aLooped: Boolean; aRadius: Single; aX, aY: Integer): Integer;

		{
			Plays WAV audio file.
			If the player index is -1 the sound will be played to all players.
			Mono and stereo WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav
			@since 5309
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayWAV: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays WAV audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			Radius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use radius 32).
			Only mono WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav.
			Will not play if the location is not revealed to the player.
			Higher volume range is allowed than PlayWAV as positional sounds are quieter
			@since 5309
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 4.0)
			@param aRadius Radius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayWAVAtLocation: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single; aRadius: Single; aX, aY: Integer): Integer;

		{
			Plays looped WAV audio file at a location on the map.
			If the player index is -1 the sound will be played to all players.
			aRadius specifies approximately the distance at which the sound can no longer be heard (normal game sounds use aRadius 32).
			Only mono WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav.
			Will not play if the location is not revealed to the player (will start playing automatically when it is revealed).
			Higher aVolume range is allowed than PlayWAV as positional sounds are quieter.
			The sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 6222
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 4.0)
			@param aRadius aRadius (minimum 28)
			@param aX, aY
			@return SoundIndex of the sound
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		PlayWAVAtLocationLooped: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single; aRadius: Single; aX, aY: Integer): Integer;

		{
			Same as PlayWAV except music will fade then mute while the WAV is playing, then fade back in afterwards.
			You should leave a small gap at the start of your WAV file to give the music time to fade
			@since 6220
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayWAVFadeMusic: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Plays looped audio file.
			If the player index is -1 the sound will be played to all players.
			Mono or stereo WAV files are supported.
			WAV file goes in mission folder named: Mission Name.filename.wav.
			The sound will continue to loop if the game is paused and will restart automatically when the game is loaded.
			@since 6222
			@param aHand
			@param aFileName
			@param aVolume Audio level (0.0 to 1.0)
			@return SoundIndex of the sound
			@kind aHand handIndex
		}
		PlayWAVLooped: function(aHand: ShortInt; aFileName: AnsiString; aVolume: Single): Integer;

		{
			Removes road
			@since 5927
			@param X, Y
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		RemoveRoad: procedure(X, Y: Integer);

		{
			Sets whether the player is allowed to trade the specified resource.
			@since 5057
			@param aHand
			@param aResType
			@param aAllowed
			@kind aHand handIndex
			@kind aResType wareTypeId
		}
		SetTradeAllowed: procedure(aHand: Integer; aResType: Integer; aAllowed: Boolean);

		{
			Displays a message to a player.
			If the player index is -1 the message will be shown to all players.
			@since 5057
			@param aHand
			@param aText
			@kind aHand handIndex
		}
		ShowMsg: procedure(aHand: ShortInt; aText: AnsiString);

		{
			Displays a message to a player with formatted arguments (same as Format function).
			If the player index is -1 the message will be shown to all players.
			@since 5333
			@param aHand
			@param aText
			@param Params Array of arguments
			@kind aHand handIndex
		}
		ShowMsgFormatted: procedure(aHand: ShortInt; aText: AnsiString; Params: array of const);

		{
			Displays a message to a player with a goto button that takes the player to the specified location.
			If the player index is -1 the message will be shown to all players.
			@since 5345
			@param aHand
			@param aX, aY
			@param aText
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		ShowMsgGoto: procedure(aHand: ShortInt; aX, aY: Integer; aText: AnsiString);

		{
			Displays a message to a player with formatted arguments (same as Format function)
			and a goto button that takes the player to the specified location.
			If the player index is -1 the message will be shown to all players.
			@since 5345
			@param aHand
			@param aX, aY
			@param aText
			@param Params Array of arguments
			@kind aHand handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		ShowMsgGotoFormatted: procedure(aHand: ShortInt; aX, aY: Integer; aText: AnsiString; Params: array of const);

		{
			Stops playing a looped sound that was previously started with either Actions.PlayOGGLooped or Actions.PlayOGGAtLocationLooped.
			@since 7000
			@param aSoundIndex value that was returned by either of those functions when the looped sound was started.
		}
		StopLoopedOGG: procedure(aSoundIndex: Integer);

		{
			Stops playing a looped sound that was previously started with either Actions.PlayWAVLooped or Actions.PlayWAVAtLocationLooped.
			@since 6222
			@param aSoundIndex value that was returned by either of those functions when the looped sound was started.
		}
		StopLoopedWAV: procedure(aSoundIndex: Integer);

		{
			Stops playing any sound that was previously started by any of PlayWAV***, PlayOGG*** or PlaySound*** functions
			@since 7000
			@param aSoundIndex value that was returned by either of those functions when the sound was started.
		}
		StopSound: procedure(aSoundIndex: Integer);

		{
			Allows allies to select and view specified unit
			For warriors: allow to select their group
			@since 12600
			@param aUnitID
			@param aAllow
			@kind aUnitID unitId
		}
		UnitAllowAllyToSelect: procedure(aUnitID: Integer; aAllow: Boolean);

		{
			Sets whether the specified player can train/equip the specified unit type
			@since 5993
			@param aHand
			@param aType
			@param aBlock
			@kind aHand handIndex
			@kind aType unitTypeId
		}
		UnitBlock: procedure(aHand: Byte; aType: Integer; aBlock: Boolean);

		{
			Makes the specified unit face a certain direction.
			Note: Only works on idle units so as not to interfere with game logic and cause crashes.
			Returns True on success or False on failure.
			@since 5057
			@deprecated Use UnitDirectionSetEx instead
			@param aUnitID
			@param aDirection
			@kind aUnitID unitId
			@kind aDirection directionId
		}
		UnitDirectionSet: function(aUnitID: Integer; aDirection: Integer): Boolean;

		{
			Makes the specified unit face a certain direction.
			Note: Only works on idle units so as not to interfere with game logic and cause crashes.
			Returns True on success or False on failure.
			@since 14000
			@param aUnitID
			@param aDirection
			@kind aUnitID unitId
		}
		UnitDirectionSetEx: function(aUnitID: Integer; aDirection: TKMDirection): Boolean;

		{
			Dismiss the specified unit
			@since 7000
			@param aUnitID
			@kind aUnitID unitId
		}
		UnitDismiss: procedure(aUnitID: Integer);

		{
			Makes the specified unit 'dismiss' command available
			@since 7000
			@param aUnitID
			@param aDismissable
			@kind aUnitID unitId
		}
		UnitDismissableSet: procedure(aUnitID: Integer; aDismissable: Boolean);

		{
			Cancel dismiss task for the specified unit
			@since 7000
			@param aUnitID
			@kind aUnitID unitId
		}
		UnitDismissCancel: procedure(aUnitID: Integer);

		{
			Set fish count to be available to catch for a fish unit of specified aUnitID
			aCount should be in range of 0 to 255. If aCount set to 0 fish unit will be instantly killed
			@since 15000
			@param aUnitID
			@param aCount
			@kind aUnitID unitId
		}
		UnitFishCountSet: procedure(aUnitID: Integer; aCount: Integer);

		{
			Heals/Wounds specified unit for aHP HP
			@since 7000
			@param aUnitID
			@param aHP
			@kind aUnitID unitId
		}
		UnitHPChange: procedure(aUnitID: Integer; aHP: Integer);

		{
			Makes the unit invulnerable. Such unit can not be killed or die from hunger.
			@since 7000
			@param aUnitID
			@param aInvulnerable
			@kind aUnitID unitId
		}
		UnitHPSetInvulnerable: procedure(aUnitID: Integer; aInvulnerable: Boolean);

		{
			Sets the hunger level of the specified unit in ticks until death
			@since 5057
			@param aUnitID
			@param aHungerLevel Hunger level (ticks until death)
			@kind aUnitID unitId
			@kind aHungerLevel tickCount
		}
		UnitHungerSet: procedure(aUnitID: Integer; aHungerLevel: Integer);

		{
			Kills the specified unit.
			Silent means the death animation (ghost) and sound won't play
			@since 5099
			@param aUnitID
			@param aSilent
			@kind aUnitID unitId
		}
		UnitKill: procedure(aUnitID: Integer; aSilent: Boolean);

		{
			Order the specified unit to walk somewhere.
			Note: Only works on idle units so as not to interfere with game logic and cause crashes.
			Returns True on success or False on failure.
			@since 5057
			@param aUnitID
			@param X, Y
			@kind aUnitID unitId
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		UnitOrderWalk: function(aUnitID: Integer; X, Y: Integer): Boolean;

	end;

var
	{
		The Actions object: tells the game what to do.
	}
	Actions: TKMScriptActions;
	{
		Short alias of Actions.
	}
	A: TKMScriptActions;
