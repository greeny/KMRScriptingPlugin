{
	KaM Remake scripting API stubs - Actions (r16020).
	GENERATED by tools/generate_stubs.py from the wiki page Actions-(Mission-Script-Dynamic); do not edit,
	put corrections into tools/overrides/r16020/Actions.script instead.
}

type
	{
		TKMScriptActions: type of the Actions object.
		@hidden
	}
	TKMScriptActions = record
		{
			Sets set of house types, houses of which Advanced AI should attack
			By default those house types are [htBarracks, htStore, htSchool, htTownHall]
			@since 14600
			@param aHand
			@param aHouses
			@kind aHand handIndex
		}
		AAIAttackHouseTypesSet: procedure(aHand: Byte; aHouses: TKMHouseTypeSet);

		{
			Sets AI army type
			@since 7000
			@param aHand
			@param aType (atIronThenLeather, atLeather, atIron, atIronAndLeather)
			@kind aHand handIndex
		}
		AIArmyType: procedure(aHand: Byte; aType: TKMArmyType);

		{
			Add AI attack
			aMeleeGroupCount, aAntiHorseGroupCount, aRangedGroupCount, aMountedGroupCount: soldiers groups count
			@since 7000
			@deprecated Use AIAttackAddEx instead
			@param aHand handID
			@param aRepeating is attack repeating
			@param aDelay attack delay from the game start (in ticks)
			@param aTotalMen total soldiers to attack
			@param aMeleeGroupCount
			@param aAntiHorseGroupCount
			@param aRangedGroupCount
			@param aMountedGroupCount
			@param aRandomGroups use random groups for attack
			@param aTarget attack target of TKMAIAttackTarget type
			@param aCustomPosition custom position of attack. Used if attCustomPosition was set up as attack target
			@return Attack UID, that could be used to remove this attack later on
			@kind aHand handIndex
			@kind aDelay tickCount
		}
		AIAttackAdd: function(aHand: Integer; aRepeating: Boolean; aDelay: Cardinal; aTotalMen: Integer; aMeleeGroupCount: Integer; aAntiHorseGroupCount: Integer; aRangedGroupCount: Integer; aMountedGroupCount: Integer; aRandomGroups: Boolean; aTarget: TKMAIAttackTarget; aCustomPosition: TKMPoint): Integer;

		{
			Add AI attack for a specified hand (player)
			Attack info is set via TKMAIAttackInfo record.
			@since 13900
			@param aHand
			@param aAttackInfo
			@return Attack UID, that could be used to remove this attack later on
			@kind aHand handIndex
		}
		AIAttackAddEx: function(aHand: Integer; var aAttackInfo: TKMAIAttackInfo): Integer;

		{
			Remove AI attack by attack UID
			@since 7000
			@param aHand
			@param aAIAttackUID
			@return True, if attack was succesfully removed, False, if attack was not found
			@kind aHand handIndex
		}
		AIAttackRemove: function(aHand: Integer; aAIAttackUID: Integer): Boolean;

		{
			Remove all AI attacks
			@since 7000
			@param aHand
			@kind aHand handIndex
		}
		AIAttackRemoveAll: procedure(aHand: Integer);

		{
			Sets AI auto attack
			@since 13000
			@param aHand
			@param aAutoAttack
			@kind aHand handIndex
		}
		AIAutoAttack: procedure(aHand: Byte; aAutoAttack: Boolean);

		{
			Sets AI auto attack range.
			AI groups will automatically attack if you are closer than this many tiles.
			@since 6251
			@param aHand
			@param aRange Range (1 to 20)
			@kind aHand handIndex
		}
		AIAutoAttackRange: procedure(aHand: Byte; aRange: Integer);

		{
			Sets whether the AI should build and manage his own village
			@since 5924
			@param aHand
			@param aAuto
			@kind aHand handIndex
		}
		AIAutoBuild: procedure(aHand: Byte; aAuto: Boolean);

		{
			Sets whether the AI should position his soldiers automatically
			@since 5924
			@param aHand
			@param aAuto
			@kind aHand handIndex
		}
		AIAutoDefence: procedure(aHand: Byte; aAuto: Boolean);

		{
			Sets whether the AI should automatically repair damaged buildings
			@since 5932
			@param aHand
			@param aAuto
			@kind aHand handIndex
		}
		AIAutoRepair: procedure(aHand: Byte; aAuto: Boolean);

		{
			Adds a defence position for the specified AI player
			Returns added defence position UID or -1 if it could not be added
			@since 5932
			@deprecated Use AIDefencePositionAddEx instead
			@param aHand
			@param X, Y
			@param aDir
			@param aGroupType
			@param aRadius
			@param aDefType
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDir directionId
			@kind aGroupType groupTypeId
		}
		AIDefencePositionAdd: function(aHand: Byte; X, Y: Integer; aDir: Byte; aGroupType: Byte; aRadius: Integer; aDefType: Byte): Integer;

		{
			Adds a defence position for the specified AI player
			If aOrder is not in range of [0; Count], then position would be added to the end of the list
			Returns added defence position UID or -1 if it could not be added
			@since 13900
			@param aHand hand (player) ID
			@param aOrder order (or priority) of the defence position.
			@param aDefencePosition
			@kind aHand handIndex
		}
		AIDefencePositionAddEx: function(aHand: Integer; aOrder: Integer; var aDefencePosition: TKMDefencePositionInfo): Integer;

		{
			Removes defence position at X, Y
			@since 6309
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		AIDefencePositionRemove: procedure(aHand: Byte; X, Y: Integer);

		{
			Removes all defence positions for specified AI player
			@since 6323
			@param aHand
			@kind aHand handIndex
		}
		AIDefencePositionRemoveAll: procedure(aHand: Byte);

		{
			Removes defence position by its UID
			@since 13900
			@param aHand
			@param aUID
			@kind aHand handIndex
		}
		AIDefencePositionRemoveByUID: procedure(aHand: Integer; aUID: Integer);

		{
			Sets whether AI should defend units and houses of allies as if they were its own
			@since 6251
			@param aHand
			@param aDefend
			@kind aHand handIndex
		}
		AIDefendAllies: procedure(aHand: Byte; aDefend: Boolean);

		{
			Sets the warriors equip rate for AI.
			@since 5778
			@param aHand
			@param aType type: 0 - leather, 1 - iron
			@param aRate
			@kind aHand handIndex
		}
		AIEquipRate: procedure(aHand: Byte; aType: Byte; aRate: Integer);

		{
			Sets the formation the AI uses for defence positions. Works only for ClassicAI
			@since 5778
			@deprecated Use AIGroupsFormationSetEx instead
			@param aHand
			@param aType
			@param aCount
			@param aColumns
			@kind aHand handIndex
			@kind aType groupTypeId
		}
		AIGroupsFormationSet: procedure(aHand: Byte; aType: Byte; aCount: Integer; aColumns: Integer);

		{
			Sets the formation the AI uses for defence positions. Works only for ClassicAI
			@since 13900
			@param aHand hand (player) ID
			@param aGroupType
			@param aCount
			@param aColumns
			@kind aHand handIndex
		}
		AIGroupsFormationSetEx: procedure(aHand: Integer; aGroupType: TKMGroupType; aCount: Integer; aColumns: Integer);

		{
			Sets the number of ticks before the specified AI will start training recruits
			@since 5924
			@param aHand
			@param aDelay
			@kind aHand handIndex
			@kind aDelay tickCount
		}
		AIRecruitDelay: procedure(aHand: Byte; aDelay: Cardinal);

		{
			Sets the number of recruits the AI will keep in each barracks
			@since 5345
			@param aHand
			@param aLimit
			@kind aHand handIndex
		}
		AIRecruitLimit: procedure(aHand: Byte; aLimit: Byte);

		{
			Sets whether the AI should automatically repair damaged buildings
			rmNone - unused
			rmRepairNever - disable repair for all houses
			rmRepairAlways - enable repair for all houses
			rmRepairManual - repair is set by script manually via Actions.HouseRepairEnable
			@since 13900
			@param aHand
			@param aRepairMode One of the values (rmNone, rmRepairNever, rmRepairAlways, rmRepairManual)
			@kind aHand handIndex
		}
		AIRepairMode: procedure(aHand: Integer; aRepairMode: TKMAIRepairMode);

		{
			Sets the number of serfs the AI will train per house.
			Can be a decimal (0.25 for 1 serf per 4 houses)
			@since 5924
			@param aHand
			@param aSerfs
			@kind aHand handIndex
		}
		AISerfsPerHouse: procedure(aHand: Byte; aSerfs: Single);

		{
			Sets the maximum number of soldiers the AI will train, or -1 for unlimited
			@since 5932
			@param aHand
			@param aLimit
			@kind aHand handIndex
		}
		AISoldiersLimit: procedure(aHand: Byte; aLimit: Integer);

		{
			Sets the AI start position which is used for targeting AI attacks
			@since 6251
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		AIStartPosition: procedure(aHand: Byte; X, Y: Integer);

		{
			Sets AI unlimited equip parameter
			@since 14800
			@param aHand
			@param aUnlimitedEquip
			@kind aHand handIndex
		}
		AIUnlimitedEquip: procedure(aHand: Byte; aUnlimitedEquip: Boolean);

		{
			Sets the maximum number of laborers the AI will train
			@since 5924
			@param aHand
			@param aLimit
			@kind aHand handIndex
		}
		AIWorkerLimit: procedure(aHand: Byte; aLimit: Byte);

		{
			Exits cinematic mode
			@since 5938
			@param aHand
			@kind aHand handIndex
		}
		CinematicEnd: procedure(aHand: Byte);

		{
			Pans the center of the player's screen to the given location over a set number of ticks.
			If Duration = 0 then the screen moves instantly.
			@since 5938
			@param aHand
			@param X, Y
			@param Duration
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind Duration tickCount
		}
		CinematicPanTo: procedure(aHand: Byte; X, Y: Integer; Duration: Integer);

		{
			Puts the player in cinematic mode, blocking user input and allowing the screen to be panned
			@since 5938
			@param aHand
			@kind aHand handIndex
		}
		CinematicStart: procedure(aHand: Byte);

		{
			Covers (un-reveals) the entire map in fog of war for player
			@since 5097
			@param aHand
			@kind aHand handIndex
		}
		FogCoverAll: procedure(aHand: Byte);

		{
			Covers a circle in fog of war for player
			@since 5097
			@param aHand
			@param X, Y
			@param aRadius
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		FogCoverCircle: procedure(aHand: Integer; X, Y: Integer; aRadius: Integer);

		{
			Covers a rectangular area in fog of war for player
			Left top corner of the map is 0:0
			Right bottom corner is MapX, MapY (f.e. 255:255)
			@since 5777
			@param aHand
			@param X1 Left coordinate of the 1st tile left top corner vertex
			@param Y1 Top coordinate of the 1st tile left top corner vertex
			@param X2 Right coordinate of the 2nd tile left top corner vertex
			@param Y2 Bottom coordinate of the 2nd tile left top corner vertex
			@kind aHand handIndex
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		FogCoverRect: procedure(aHand: Integer; X1: Integer; Y1: Integer; X2: Integer; Y2: Integer);

		{
			Reveals the entire map in fog of war for player
			@since 5097
			@param aHand
			@kind aHand handIndex
		}
		FogRevealAll: procedure(aHand: Byte);

		{
			Reveals a circle in fog of war for player
			@since 5097
			@param aHand
			@param X, Y
			@param aRadius
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		FogRevealCircle: procedure(aHand: Integer; X, Y: Integer; aRadius: Integer);

		{
			Reveals a rectangular area in fog of war for player
			Left top corner of the map is 0:0
			Right bottom corner is MapX, MapY (f.e. 255:255)
			@since 5777
			@param aHand
			@param X1 Left coordinate of the 1st tile left top corner vertex
			@param Y1 Top coordinate of the 1st tile left top corner vertex
			@param X2 Right coordinate of the 2nd tile left top corner vertex
			@param Y2 Bottom coordinate of the 2nd tile left top corner vertex
			@kind aHand handIndex
			@kind X1 xCoordinate
			@kind Y1 yCoordinate
			@kind X2 xCoordinate
			@kind Y2 yCoordinate
		}
		FogRevealRect: procedure(aHand: Integer; X1: Integer; Y1: Integer; X2: Integer; Y2: Integer);

		{
			Changes game speed
			@since 11000
			@param aSpeed
		}
		GameSpeed: procedure(aSpeed: Single);

		{
			Allows or blocks game speed change
			@since 11000
			@param aAllowed
		}
		GameSpeedChangeAllowed: procedure(aAllowed: Boolean);

		{
			Adds an animal to the game and returns the unit ID or -1 if the animal was not able to be added
			@since 5057
			@deprecated Use GiveAnimalEx instead
			@param aType
			@param X, Y
			@kind aType unitTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		GiveAnimal: function(aType: Integer; X, Y: Integer): Integer;

		{
			Adds an animal to the game and returns the unit ID or -1 if the animal was not able to be added
			@since 14000
			@param aType
			@param X, Y
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		GiveAnimalEx: function(aType: TKMUnitType; X, Y: Integer): Integer;

		{
			Adds finished field and returns True if field was successfully added
			@since 6311
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveField: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Sets field age if tile is corn field, or adds finished field and sets its age if tile is empty, and returns True if this was successfully done
			@since 7000
			@param aHand
			@param X, Y
			@param aStage 0..6, sets the field growth stage. 0 = empty field; 6 = corn has been cut
			@param aRandomAge sets FieldAge to random, according to specified stage. Makes fields more realistic
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveFieldAged: function(aHand: Integer; X, Y: Integer; aStage: Byte; aRandomAge: Boolean): Boolean;

		{
			Adds fish to a specified position with aCount fish available to catch
			aCount should be in range of 1 to 255
			Returns the unit ID or -1 if the fish was not able to be added
			@since 15000
			@param X, Y
			@param aCount
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveFish: function(X, Y: Integer; aCount: Integer): Integer;

		{
			Give player group of warriors and return the group ID or -1 if the group was not able to be added
			@since 5057
			@deprecated Use GiveGroupEx instead
			@param aHand
			@param aType
			@param X, Y
			@param aDir
			@param aCount
			@param aColumns Units per row
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDir directionId
			@kind groupId
		}
		GiveGroup: function(aHand: Integer; aType: Integer; X, Y: Integer; aDir: Integer; aCount: Integer; aColumns: Integer): Integer;

		{
			Give player group of warriors and return the group ID or -1 if the group was not able to be added
			@since 14000
			@param aHand
			@param aType
			@param X, Y
			@param aDir
			@param aCount
			@param aColumns Units per row
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind groupId
		}
		GiveGroupEx: function(aHand: Integer; aType: TKMUnitType; X, Y: Integer; aDir: TKMDirection; aCount: Integer; aColumns: Integer): Integer;

		{
			Give player a built house and returns the house ID or -1 if the house was not able to be added
			@since 5097
			@deprecated Use GiveHouseEx instead
			@param aHand
			@param aHouseType
			@param X, Y
			@kind aHand handIndex
			@kind aHouseType houseTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		GiveHouse: function(aHand: Integer; aHouseType: Integer; X, Y: Integer): Integer;

		{
			Give player a built house and returns the house ID or -1 if the house was not able to be added
			@since 14000
			@param aHand
			@param aHouseType
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		GiveHouseEx: function(aHand: Integer; aHouseType: TKMHouseType; X, Y: Integer): Integer;

		{
			Give player a digged house area and returns House ID or -1 if house site was not able to be added.
			If AddMaterials = True, wood and stone will be added
			@since 6288
			@deprecated Use GiveHouseSiteEx instead
			@param aHand
			@param aHouseType
			@param X, Y
			@param aAddMaterials
			@kind aHand handIndex
			@kind aHouseType houseTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		GiveHouseSite: function(aHand: Integer; aHouseType: Integer; X, Y: Integer; aAddMaterials: Boolean): Integer;

		{
			Give player a digged house area and returns House ID or -1 if house site was not able to be added.
			@since 14000
			@param aHand
			@param aHouseType
			@param X, Y
			@param aWoodAmount number of resources to be added to the site
			@param aStoneAmount number of resources to be added to the site
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind houseId
		}
		GiveHouseSiteEx: function(aHand: Integer; aHouseType: TKMHouseType; X, Y: Integer; aWoodAmount: Integer; aStoneAmount: Integer): Integer;

		{
			Adds finished road and returns True if road was successfully added
			@since 6311
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveRoad: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Give player a single citizen and returns the unit ID or -1 if the unit was not able to be added
			@since 5057
			@deprecated Use GiveUnitEx instead
			@param aHand
			@param aType
			@param X, Y
			@param aDir
			@kind aHand handIndex
			@kind aType unitTypeId
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind aDir directionId
			@kind unitId
		}
		GiveUnit: function(aHand: Integer; aType: Integer; X, Y: Integer; aDir: Integer): Integer;

		{
			Give player a single citizen and returns the unit ID or -1 if the unit was not able to be added
			@since 14000
			@param aHand
			@param aType
			@param X, Y
			@param aDir
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
			@kind unitId
		}
		GiveUnitEx: function(aHand: Integer; aType: TKMUnitType; X, Y: Integer; aDir: TKMDirection): Integer;

		{
			Adds amount of wares to players 1st Store
			Wares are added to first Store
			@since 5057
			@deprecated Use GiveWaresEx instead
			@param aHand
			@param aType
			@param aCount
			@kind aHand handIndex
			@kind aType wareTypeId
		}
		GiveWares: procedure(aHand: Integer; aType: Integer; aCount: Integer);

		{
			Adds amount of wares to players 1st Store
			Wares are added to first Store
			@since 14000
			@param aHand
			@param aType
			@param aCount
			@kind aHand handIndex
		}
		GiveWaresEx: procedure(aHand: Integer; aType: TKMWareType; aCount: Integer);

		{
			Adds amount of weapons to players 1st Barracks
			Weapons are added to first Barracks
			@since 5165
			@deprecated Use GiveWeaponsEx instead
			@param aHand
			@param aType
			@param aCount
			@kind aHand handIndex
			@kind aType wareTypeId
		}
		GiveWeapons: procedure(aHand: Integer; aType: Integer; aCount: Integer);

		{
			Adds amount of weapons to players 1st Barracks
			Weapons are added to first Barracks
			@since 14000
			@param aHand
			@param aType
			@param aCount
			@kind aHand handIndex
		}
		GiveWeaponsEx: procedure(aHand: Integer; aType: TKMWareType; aCount: Integer);

		{
			Adds finished winefield and returns True if winefield was successfully added
			@since 6311
			@param aHand
			@param X, Y
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveWineField: function(aHand: Integer; X, Y: Integer): Boolean;

		{
			Sets winefield age if tile is winefield, or adds finished winefield and sets its age if tile is empty, and returns True if this was successfully done
			@since 7000
			@param aHand
			@param X, Y
			@param aStage 0..3, sets the field growth stage. 0 = new fruits; 3 = grapes are ready to be harvested; according to WINE_STAGES_COUNT
			@param aRandomAge sets FieldAge to random, according to specified stage. Makes fields more realistic
			@kind aHand handIndex
			@kind X xCoordinate
			@kind Y yCoordinate
		}
		GiveWineFieldAged: function(aHand: Integer; X, Y: Integer; aStage: Byte; aRandomAge: Boolean): Boolean;

		{
			Allows allies to select and view specified group
			@since 12600
			@param aGroupID
			@param aAllow
			@kind aGroupID groupId
		}
		GroupAllowAllyToSelect: procedure(aGroupID: Integer; aAllow: Boolean);

		{
			Disables (Disable = True) or enables (Disable = False) control over specifed warriors group
			@since 6277
			@param aGroupID
			@param aBlock
			@kind aGroupID groupId
		}
		GroupBlockOrders: procedure(aGroupID: Integer; aBlock: Boolean);

		{
			Sets whether the specified group will alert the player when they become hungry
			(True to disable hunger messages, False to enable them)
			@since 5993
			@param aGroupID
			@param aDisable
			@kind aGroupID groupId
		}
		GroupDisableHungryMessage: procedure(aGroupID: Integer; aDisable: Boolean);

		{
			Set hunger level for all group members
			@since 5993
			@param aGroupID
			@param aHungerLevel Hunger level (ticks until death)
			@kind aGroupID groupId
			@kind aHungerLevel tickCount
		}
		GroupHungerSet: procedure(aGroupID: Integer; aHungerLevel: Integer);

		{
			Kills all members of the specified group
			@since 5993
			@param aGroupID
			@param aSilent
			@kind aGroupID groupId
		}
		GroupKillAll: procedure(aGroupID: Integer; aSilent: Boolean);

		{
			Order the specified group to attack the specified house
			@since 5057
			@param aGroupID
			@param aHouseID
			@kind aGroupID groupId
			@kind aHouseID houseId
		}
		GroupOrderAttackHouse: procedure(aGroupID: Integer; aHouseID: Integer);

		{
			Order the specified group to attack the specified unit
			@since 5057
			@param aGroupID
			@param aUnitID
			@kind aGroupID groupId
			@kind aUnitID unitId
		}
		GroupOrderAttackUnit: procedure(aGroupID: Integer; aUnitID: Integer);

		{
			Order the specified group to request food
