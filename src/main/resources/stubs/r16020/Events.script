{
	KaM Remake scripting API stubs - Events (r16020).
	GENERATED by tools/generate_stubs.py from the wiki page Events-(Mission-Script-Dynamic); do not edit,
	put corrections into tools/overrides/r16020/Events.script instead.
}

{
	This file is NOT part of the user's scope. Each field describes one event: the field name is the conventional
	handler procedure name, its type is the required handler signature, @event the name used in the $EVENT directive.
}
type
	TKMScriptEvents = record
		{
			Occurs when a player places a beacon on the map.
			@event evtBeacon
			@since 6570
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnBeacon: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when player built a field.
			@event evtFieldBuilt
			@since 7000
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnFieldBuilt: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when game speed was changed
			@event evtGameSpeedChanged
			@since 11000
			@param aSpeed
		}
		OnGameSpeedChanged: procedure(aSpeed: Single);

		{
			Occurs right before the group gets order to split.
			Split parameters could be altered by script and returned to the game to be used there
			@event evtGroupBeforeOrderSplit
			@since 11200
			@param aGroup group ID, which got split order
			@param aNewType new group leader unit type
			@param aNewCnt new group members count
			@param aMixed is new group can have the only unit type or it can have any unit type from original group
			@kind aGroup groupId
		}
		OnGroupBeforeOrderSplit: procedure(aGroup: Integer; var aNewType: TKMUnitType; var aNewCnt: Integer; var aMixed: Boolean);

		{
			Occurs when the player would be shown a message about a group being hungry
			(when they first get hungry, then every 4 minutes after that if there are still hungry group members).
			Occurs regardless of whether the group has hunger messages enabled or not.
			@event evtGroupHungry
			@since 6220
			@param aGroup
			@kind aGroup groupId
		}
		OnGroupHungry: procedure(aGroup: Integer);

		{
			Occurs when the group gets order to attack house
			@event evtGroupOrderAttackHouse
			@since 7000
			@param aGroup attackers group ID
			@param aHouse target house ID
			@kind aGroup groupId
			@kind aHouse houseId
		}
		OnGroupOrderAttackHouse: procedure(aGroup: Integer; aHouse: Integer);

		{
			Occurs when the group gets order to attack unit
			@event evtGroupOrderAttackUnit
			@since 7000
			@param aGroup attackers group ID
			@param aUnit target unit ID
			@kind aGroup groupId
			@kind aUnit unitId
		}
		OnGroupOrderAttackUnit: procedure(aGroup: Integer; aUnit: Integer);

		{
			Occurs when the group1 gets order to link to group2
			@event evtGroupOrderLink
			@since 7000
			@param aGroup1 link group ID
			@param aGroup2 link target group ID
			@kind aGroup1 groupId
			@kind aGroup2 groupId
		}
		OnGroupOrderLink: procedure(aGroup1: Integer; aGroup2: Integer);

		{
			Occurs when the group gets order to move to some point
			aX, aY: Point coordinates
			@event evtGroupOrderMove
			@since 7000
			@param aGroup group ID
			@param aX, aY
			@param aDir
			@kind aGroup groupId
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnGroupOrderMove: procedure(aGroup: Integer; aX, aY: Integer; aDir: TKMDirection);

		{
			Occurs when the group gets order to split
			@event evtGroupOrderSplit
			@since 7000
			@param aGroup group ID
			@param aNewGroup splitted group ID
			@kind aGroup groupId
			@kind aNewGroup groupId
		}
		OnGroupOrderSplit: procedure(aGroup: Integer; aNewGroup: Integer);

		{
			Occurs after a house is destroyed and has been completely removed from the game,
			meaning the area it previously occupied can be used.
			If you need more information about the house use the OnHouseDestroyed event.
			aHouseType as Integer from Lookup table
			@event evtHouseAfterDestroyed
			@since 6114
			@deprecated Use OnHouseAfterDestroyedEx instead
			@param aHouseType
			@param aOwner
			@param aX, aY
			@kind aHouseType houseTypeId
			@kind aOwner handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnHouseAfterDestroyed: procedure(aHouseType: Integer; aOwner: Integer; aX, aY: Integer);

		{
			Occurs after a house is destroyed and has been completely removed from the game,
			meaning the area it previously occupied can be used.
			If you need more information about the house use the OnHouseDestroyed event.
			@event evtHouseAfterDestroyedEx
			@since 14000
			@param aHouseType as TKMHouseType
			@param aOwner
			@param aX, aY
			@kind aOwner handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnHouseAfterDestroyedEx: procedure(aHouseType: TKMHouseType; aOwner: Integer; aX, aY: Integer);

		{
			Occurs when player has built a house.
			@event evtHouseBuilt
			@since 5057
			@param aHouse
			@kind aHouse houseId
		}
		OnHouseBuilt: procedure(aHouse: Integer);

		{
			Occurs when a house gets damaged (e.g. by the enemy soldier).
			Attacker is -1 the house was damaged some other way, such as from Actions.HouseAddDamage.
			@event evtHouseDamaged
			@since 5882
			@param aHouse
			@param aAttacker
			@kind aHouse houseId
			@kind aAttacker unitId
		}
		OnHouseDamaged: procedure(aHouse: Integer; aAttacker: Integer);

		{
			Occurs when a house delivery mode changed.
			@event evtHouseDeliveryModeChanged
			@since 15250
			@param aHouse
			@param aOldMode
			@param aNewMode
			@kind aHouse houseId
		}
		OnHouseDeliveryModeChanged: procedure(aHouse: Integer; aOldMode: TKMDeliveryMode; aNewMode: TKMDeliveryMode);

		{
			Occurs when a house is destroyed.
			If DestroyerIndex is -1 the house was destroyed some other way, such as from Actions.HouseDestroy.
			If DestroyerIndex is the same as the house owner (States.HouseOwner), the house was demolished by the player who owns it.
			Otherwise it was destroyed by an enemy.
			Called just before the house is destroyed so HouseID is usable only during this event, and the area occupied by the house is still unusable.
			@event evtHouseDestroyed
			@since 5407
			@param aHouse
			@param aDestroyerIndex Index of player who destroyed it
			@kind aHouse houseId
			@kind aDestroyerIndex handIndex
		}
		OnHouseDestroyed: procedure(aHouse: Integer; aDestroyerIndex: Integer);

		{
			aOldX, aOldY - Coordinates of the previous FlagPoint position
			aNewX, aNewY - Coordinates of the new FlagPoint position
			Occurs when a house flag point position is changed
			@event evtHouseFlagPointChanged
			@since 15250
			@param aHouse
			@param aOldX
			@param aOldY
			@param aNewX
			@param aNewY
			@kind aHouse houseId
			@kind aOldX xCoordinate
			@kind aOldY yCoordinate
			@kind aNewX xCoordinate
			@kind aNewY yCoordinate
		}
		OnHouseFlagPointChanged: procedure(aHouse: Integer; aOldX: Integer; aOldY: Integer; aNewX: Integer; aNewY: Integer);

		{
			Occurs when house plan is digged.
			@event evtHousePlanDigged
			@since 7000
			@param aHouse
			@kind aHouse houseId
		}
		OnHousePlanDigged: procedure(aHouse: Integer);

		{
			Occurs when player has placed a house plan.
			@event evtHousePlanPlaced
			@since 5871
			@deprecated Use OnHousePlanPlacedEx instead
			@param aPlayer
			@param aX, aY
			@param aHouseType as Integer from Lookup table
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind aHouseType houseTypeId
		}
		OnHousePlanPlaced: procedure(aPlayer: Integer; aX, aY: Integer; aHouseType: Integer);

		{
			Occurs when player has placed a house plan.
			@event evtHousePlanPlacedEx
			@since 14000
			@param aPlayer
			@param aX, aY
			@param aHouseType as TKMHouseType
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnHousePlanPlacedEx: procedure(aPlayer: Integer; aX, aY: Integer; aHouseType: TKMHouseType);

		{
			Occurs when player has removed a house plan.
			@event evtHousePlanRemoved
			@since 6298
			@deprecated Use OnHousePlanRemovedEx instead
			@param aPlayer
			@param aX, aY
			@param aHouseType as Integer from Lookup table
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
			@kind aHouseType houseTypeId
		}
		OnHousePlanRemoved: procedure(aPlayer: Integer; aX, aY: Integer; aHouseType: Integer);

		{
			Occurs when player has removed a house plan.
			@event evtHousePlanRemovedEx
			@since 14000
			@param aPlayer
			@param aX, aY
			@param aHouseType as TKMHouseType
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnHousePlanRemovedEx: procedure(aPlayer: Integer; aX, aY: Integer; aHouseType: TKMHouseType);

		{
			Occurs when a house gets repaired.
			The event gets fired for each repair action
			@event evtHouseRepaired
			@since 13700
			@param aHouse House ID
			@param aRepairAmount how much house was repaired
			@param aDamage house damage after repairement
			@kind aHouse houseId
		}
		OnHouseRepaired: procedure(aHouse: Integer; aRepairAmount: Integer; aDamage: Integer);

		{
			Occurs when ware count is changed in house
			@event evtHouseWareCountChanged
			@since 10750
			@param aHouse
			@param aWare
			@param aCnt current ware count in house (after change)
			@param aChangeCnt ware change count. if aChangeCnt > 0 count increased, if aChangeCnt < 0 count decreased
			@kind aHouse houseId
		}
		OnHouseWareCountChanged: procedure(aHouse: Integer; aWare: TKMWareType; aCnt: Integer; aChangeCnt: Integer);

		{
			Occurs when a trade happens in a market (at the moment when resources are exchanged by serfs).
			@event evtMarketTrade
			@since 6216
			@deprecated Use OnMarketTradeEx instead
			@param aMarket
			@param aWareFrom as Integer from Lookup table
			@param aWareTo as Integer from Lookup table
			@kind aMarket houseId
			@kind aWareFrom wareTypeId
			@kind aWareTo wareTypeId
		}
		OnMarketTrade: procedure(aMarket: Integer; aWareFrom: Integer; aWareTo: Integer);

		{
			Occurs when a trade happens in a market (at the moment when resources are exchanged by serfs).
			@event evtMarketTradeEx
			@since 14000
			@param aMarket
			@param aWareFrom as TKMWareType
			@param aWareTo as TKMWareType
			@kind aMarket houseId
		}
		OnMarketTradeEx: procedure(aMarket: Integer; aWareFrom: TKMWareType; aWareTo: TKMWareType);

		{
			Occurs immediately after the mission is loaded.
			@event evtMissionStart
			@since 5057
		}
		OnMissionStart: procedure;

		{
			Occurs immediately after the end of peacetime
			@event evtPeacetimeEnd
			@since 11000
		}
		OnPeacetimeEnd: procedure;

		{
			Occurs when player has placed a field plan.
			@event evtPlanFieldPlaced
			@since 5964
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanFieldPlaced: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when player has removed a field plan.
			@event evtPlanFieldRemoved
			@since 6301
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanFieldRemoved: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when road plan is digged.
			@event evtPlanRoadDigged
			@since 7000
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanRoadDigged: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when player has placed a road plan.
			@event evtPlanRoadPlaced
			@since 5964
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanRoadPlaced: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when player has removed a road plan.
			@event evtPlanRoadRemoved
			@since 6301
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanRoadRemoved: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when winefield is digged
			@event evtPlanWinefieldDigged
			@since 7000
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanWinefieldDigged: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when player has placed a wine field plan.
			@event evtPlanWinefieldPlaced
			@since 5964
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanWinefieldPlaced: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when player has removed a wine field plan.
			@event evtPlanWinefieldRemoved
			@since 6301
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnPlanWinefieldRemoved: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when certain player has been defeated.
			Defeat conditions are checked separately by Player AI.
			@event evtPlayerDefeated
			@since 5057
			@param aPlayer
			@kind aPlayer handIndex
		}
		OnPlayerDefeated: procedure(aPlayer: Integer);

		{
			Occurs when certain player is declared victorious.
			Victory conditions are checked separately by Player AI.
			@event evtPlayerVictory
			@since 5057
			@param aPlayer
			@kind aPlayer handIndex
		}
		OnPlayerVictory: procedure(aPlayer: Integer);

		{
			Occurs when player built a road.
			@event evtRoadBuilt
			@since 7000
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnRoadBuilt: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs every game logic update.
			@event evtTick
			@since 5057
		}
		OnTick: procedure;

		{
			Occurs after a unit has died and has been completely removed from the game, meaning the tile it previously occupied can be used.
			If you need more information about the unit use the OnUnitDied event.
			Note: Because units have a death animation there is a delay of several ticks between OnUnitDied and OnUnitAfterDied.
			@event evtUnitAfterDied
			@since 6114
			@deprecated Use OnUnitAfterDiedEx instead
			@param aUnitType as Integer from Lookup table
			@param aOwner
			@param aX, aY
			@kind aUnitType unitTypeId
			@kind aOwner handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnUnitAfterDied: procedure(aUnitType: Integer; aOwner: Integer; aX, aY: Integer);

		{
			Occurs after a unit has died and has been completely removed from the game, meaning the tile it previously occupied can be used.
			If you need more information about the unit use the OnUnitDied event.
			Note: Because units have a death animation there is a delay of several ticks between OnUnitDied and OnUnitAfterDied.
			@event evtUnitAfterDiedEx
			@since 14000
			@param aUnitType as TKMUnitType
			@param aOwner
			@param aX, aY
			@kind aOwner handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnUnitAfterDiedEx: procedure(aUnitType: TKMUnitType; aOwner: Integer; aX, aY: Integer);

		{
			Happens when a unit is attacked (shot at by archers, hit in melee, or shot by a tower).
			Attacker can be a warrior, recruit in tower or unknown (-1).
			This event will occur very frequently during battles.
			@event evtUnitAttacked
			@since 6587
			@param aUnit
			@param aAttacker Unit who attacked the unit
			@kind aUnit unitId
			@kind aAttacker unitId
		}
		OnUnitAttacked: procedure(aUnit: Integer; aAttacker: Integer);

		{
			Occurs when a unit dies. If KillerIndex is -1 the unit died from another cause such as hunger or Actions.UnitKill.
			Called just before the unit is killed so UnitID is usable only during this event,
			and the tile occupied by the unit is still taken.
			@event evtUnitDied
			@since 5407
			@param aUnit
			@param aKillerOwner Index of player who killed it
			@kind aUnit unitId
			@kind aKillerOwner handIndex
		}
		OnUnitDied: procedure(aUnit: Integer; aKillerOwner: Integer);

		{
			Occurs when a unit is dissmised.
			Called just before the unit is dissmised so UnitID is usable only during this event,
			and the tile occupied by the unit is still taken.
			@event evtUnitDismissed
			@since 15250
			@param aUnit
			@kind aUnit unitId
		}
		OnUnitDismissed: procedure(aUnit: Integer);

		{
			Occurs when player trains a unit.
			@event evtUnitTrained
			@since 5057
			@param aUnit
			@kind aUnit unitId
		}
		OnUnitTrained: procedure(aUnit: Integer);

		{
			Happens when unit is wounded.
			Attacker can be a warrior, recruit in tower or unknown (-1).
			@event evtUnitWounded
			@since 5884
			@param aUnit
			@param aAttacker Unit who attacked the unit
			@kind aUnit unitId
			@kind aAttacker unitId
		}
		OnUnitWounded: procedure(aUnit: Integer; aAttacker: Integer);

		{
			Occurs when resource is produced for specified house.
			@event evtWareProduced
			@since 14000
			@param aHouse
			@param aWareType
			@param aCount
			@kind aHouse houseId
		}
		OnWareProduced: procedure(aHouse: Integer; aWareType: TKMWareType; aCount: Integer);

		{
			Occurs when player equips a warrior.
			@event evtWarriorEquipped
			@since 5057
			@param aUnit
			@param aGroup
			@kind aUnit unitId
			@kind aGroup groupId
		}
		OnWarriorEquipped: procedure(aUnit: Integer; aGroup: Integer);

		{
			Occurs when warrior walk
			@event evtWarriorWalked
			@since 7000
			@param aUnit
			@param aToX
			@param aToY
			@kind aUnit unitId
			@kind aToX xCoordinate
			@kind aToY yCoordinate
		}
		OnWarriorWalked: procedure(aUnit: Integer; aToX: Integer; aToY: Integer);

		{
			Occurs when player built a winefield.
			@event evtWinefieldBuilt
			@since 7000
			@param aPlayer
			@param aX, aY
			@kind aPlayer handIndex
			@kind aX xCoordinate
			@kind aY yCoordinate
		}
		OnWinefieldBuilt: procedure(aPlayer: Integer; aX, aY: Integer);

		{
			Occurs when woodcutters mode changed.
			@event evtWoodcuttersModeChanged
			@since 15250
			@param aHouse
			@param aOldMode
			@param aNewMode
			@kind aHouse houseId
		}
		OnWoodcuttersModeChanged: procedure(aHouse: Integer; aOldMode: TKMWoodcutterMode; aNewMode: TKMWoodcutterMode);

	end;
